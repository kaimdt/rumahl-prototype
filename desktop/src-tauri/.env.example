# IORA Desktop Client - Compile-Time Configuration
# These values are baked into the binary during compilation
# Copy this file to .env and customize for your environment

# IORA Home backend URL
IORA_HOME_URL=http://localhost:3001

# LM Studio URL (OpenAI-compatible API)
LM_STUDIO_URL=http://localhost:1234

# IORA Backend URL (iora-assist)
IORA_BACKEND_URL=http://localhost:8092

# Proxy port for IORA→LM Studio
PROXY_PORT=11435

# Health check interval in seconds
HEALTH_POLL_INTERVAL_SECS=30

# Home Assistant metrics update interval in seconds
HA_UPDATE_INTERVAL_SECS=60
