# IORA – Umgebungsvariablen für Docker Compose
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=iora
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iora_home
POSTGRES_PORT=5432

# ── Service-Ports ──────────────────────────────────────────────────────
# iora-home (Dashboard + API):   8126 (IORA OS default) / 3001 (dev)
HOME_PORT=8126
CORE_PORT=8090
CONTROL_PORT=8091
ASSIST_PORT=8092
SECRETS_PORT=8093
WATCHDOG_PORT=8094
SECURITY_PORT=8095
GATEWAY_PORT=8096
SUPERVISOR_PORT=8097
APPSTORE_PORT=8098
INTELLIGENCE_PORT=8099
BACKUP_PORT=8100
FILES_PORT=8102
UPDATER_PORT=8103
CONNECTOR_PORT=8104
NGINX_PORT=8080
NETWORK_MONITOR_PORT=8105

# ── Secrets & Tokens ───────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
SECRETS_MASTER_KEY=change-me-to-a-secure-key
SECURITY_DB_KEY=change-me-to-another-key

# ── Home Assistant Integration ─────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ── AI / Assist ────────────────────────────────────────────────────────
ASSIST_AI_BACKEND_URL=
ASSIST_AI_API_KEY=

# ── E-Mail / Gateway ───────────────────────────────────────────────────
SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Logging ────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Supervisor (IORA OS only) ──────────────────────────────────────────
SUPERVISOR_URL=http://iora-supervisor:8097
