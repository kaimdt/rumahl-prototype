# API base URL of the PHP backend.
# Same-origin default: the backend is deployed to /api/ on the same domain.
# For local dev against a remote/staging backend, set e.g.:
# NEXT_PUBLIC_API_BASE=https://status.rumahl.com/api
NEXT_PUBLIC_API_BASE=/api

# Optional central Rust identity login entry point. After authentication the
# identity gateway redirects back to /admin/ and injects signed X-Rumahl-*
# headers for backend requests.
# NEXT_PUBLIC_CENTRAL_LOGIN_URL=https://accounts.rumahl.com/login?return_to=https%3A%2F%2Fstatus.rumahl.com%2Fadmin%2F
# NEXT_PUBLIC_CENTRAL_LOGOUT_URL=https://accounts.rumahl.com/logout?return_to=https%3A%2F%2Fstatus.rumahl.com%2F
