config BR2_PACKAGE_RUMAHL_DEV_TOOLCHAIN
	bool "ora dev native build toolchain"
	depends on BR2_aarch64 || BR2_x86_64
	depends on BR2_TOOLCHAIN_GLIBC
	depends on BR2_USE_MMU
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_BINUTILS
	select BR2_PACKAGE_BINUTILS_TARGET
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_CLANG
	select BR2_PACKAGE_CMAKE
	select BR2_PACKAGE_GIT
	select BR2_PACKAGE_LIBCURL_CURL
	select BR2_PACKAGE_MAKE
	select BR2_PACKAGE_NODEJS
	select BR2_PACKAGE_NODEJS_NPM
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_PERL
	select BR2_PACKAGE_PKGCONF
	select BR2_PACKAGE_POSTGRESQL
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_PIP
	help
	  Install native build tooling into rumahl OS Dev images so the
	  developer bridge can build Rust/Node/Python based services on
	  the device without pulling large Docker builder images.

	  This intentionally makes DEV images larger. Do not enable this
	  package for production images.
