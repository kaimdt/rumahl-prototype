# rumahl-dev-bridge.service — rumahl OS Dev hot-reload bridge
#
# ⚠️  DEV IMAGES ONLY — never shipped on production.
# ⚠️  Runs as ROOT: needs full filesystem access, systemctl, docker.
# ⚠️  Binds to 0.0.0.0:8101 — reachable from developer workstation.
#     (8099 is reserved for rumahl-api.)
#
# The bridge authenticates via:
#   1. rumahl dashboard credentials (POST /dev/auth → rumahl-home login)
#   2. Static token file at /var/lib/ora/dev-token (legacy fallback)
#
# Install:
#   sudo cp rumahl-dev-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rumahl-dev-bridge
#
[Unit]
Description=rumahl OS Dev Bridge (hot-reload endpoint)
Documentation=https://ora.os/docs/development
After=network-online.target rumahl-home.service docker.service
Wants=network-online.target rumahl-home.service

[Service]
Type=simple
# ⚠️  MUST run as root for binary replacement and systemctl access
User=root
Group=root
ExecStart=/usr/bin/rumahl-dev-bridge --listen 0.0.0.0:8101
Restart=always
RestartSec=5
# Environment overrides:
#   RUMAHL_DEV_BIND=127.0.0.1:8101        (bind to localhost only)
#   RUMAHL_DEV_TOKEN_FILE=/custom/path    (static token file location)
Environment=RUST_LOG=info
# Give rumahl-home time to start before we try credential auth
ExecStartPre=/bin/sleep 2
# Allow binding to port even if lingering from previous crash
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
