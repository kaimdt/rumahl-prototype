# rumahl NGINX Configuration Template
# This configuration is dynamically generated by rumahl-nginx service

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
}

http {
    # WebSocket upgrade mapping (used by the root location and the API
    # proxy locations so the app gateway WS tunnel can relay upgrades).
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # Performance
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # Security headers
    # NOTE: X-Frame-Options is deliberately NOT set globally. The App
    # Embedding Gateway (rumahl-home) controls framing centrally via CSP
    # frame-ancestors on the app subdomains (<app-id>.apps.rumahl.local) and
    # strips X-Frame-Options from proxied app responses. A global header
    # would re-block the embedded apps.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss
               application/rss+xml font/truetype font/opentype
               application/vnd.ms-fontobject image/svg+xml;

    # Rate limiting zones
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=general_limit:10m rate=50r/s;

    # Upstream for rumahl services
    upstream rumahl_home {
        server 127.0.0.1:8080;
        keepalive 32;
    }

    upstream rumahl_core {
        server 127.0.0.1:8090;
        keepalive 32;
    }

    upstream rumahl_control {
        server 127.0.0.1:8091;
        keepalive 32;
    }

    upstream rumahl_assist {
        server 127.0.0.1:8092;
        keepalive 32;
    }

    upstream rumahl_secrets {
        server 127.0.0.1:8093;
        keepalive 32;
    }

    upstream rumahl_watchdog {
        server 127.0.0.1:8094;
        keepalive 32;
    }

    upstream rumahl_security {
        server 127.0.0.1:8095;
        keepalive 32;
    }

    upstream rumahl_gateway {
        server 127.0.0.1:8096;
        keepalive 32;
    }

    upstream rumahl_supervisor {
        server 127.0.0.1:8097;
        keepalive 32;
    }

    upstream rumahl_appstore {
        server 127.0.0.1:8098;
        keepalive 32;
    }

    upstream rumahl_account {
        server 127.0.0.1:8110;
        keepalive 32;
    }

    upstream rumahl_network_monitor {
        server 127.0.0.1:8099;
        keepalive 32;
    }

    upstream rumahl_domain_validator {
        server 127.0.0.1:8100;
        keepalive 32;
    }

    upstream rumahl_resource_manager {
        server 127.0.0.1:8101;
        keepalive 32;
    }

    upstream rumahl_connector {
        server 127.0.0.1:8102;
        keepalive 32;
    }

    upstream rumahl_files {
        server 127.0.0.1:8103;
        keepalive 32;
    }

    upstream rumahl_api {
        server 127.0.0.1:8104;
        keepalive 32;
    }

    # Dynamic app upstreams are gone — installed apps are served by the App
    # Embedding Gateway on their own origin (`<app-id>.apps.rumahl.local`,
    # routed to rumahl-home below). The gateway resolves runtime targets from
    # the live app lifecycle, so app start/stop/restart needs no nginx
    # reload. Legacy `/apps/<id>/` path proxying was removed with it.

    # Central account API. The account frontend will be routed separately once
    # its standalone deployment is added. Production enables TLS at this host.
    server {
        listen 80;
        listen [::]:80;
        server_name account.rumahl.com;

        location /api/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_account/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # Main server block (HTTP)
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        # Redirect to HTTPS (can be disabled for local development)
        # return 301 https://$host$request_uri;

        # Root location - rumahl Home
        location / {
            limit_req zone=general_limit burst=20 nodelay;
            proxy_pass http://rumahl_home;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # API locations already relay WebSocket upgrades (Connection
        # 'upgrade' is set per location) so the same-origin app proxy WS
        # tunnel works through nginx.

        # rumahl Core API
        location /api/core/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_core/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Control Center
        location /api/control/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_control/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Assistant
        # NOTE: proxy_pass without trailing slash preserves the full
        # /api/assist/* URI because rumahl-assist mounts its routes at
        # `/api/assist/...` directly (not stripped). Stripping the prefix
        # here would 404 every assist endpoint.
        location /api/assist/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://rumahl_assist;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # rumahl Secrets
        location /api/secrets/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://rumahl_secrets/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Watchdog
        location /api/watchdog/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://rumahl_watchdog/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Security
        location /api/security/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_security/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Gateway
        location /api/gateway/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_gateway/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Supervisor
        location /api/supervisor/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_supervisor/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl App Store
        location /api/appstore/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_appstore/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Network Monitor
        location /api/network/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_network_monitor/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Domain Validator
        location /api/domain-validator/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://rumahl_domain_validator/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Resource Manager
        location /api/resources/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://rumahl_resource_manager/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        # rumahl Connector (Cloud-Tunnel)
        location /api/connector/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://rumahl_connector;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl Files (Cloud Storage)
        location /api/files/ {
            limit_req zone=api_limit burst=10 nodelay;
            client_max_body_size 0;
            proxy_pass http://rumahl_files;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # rumahl API (GraphQL / WebDAV / CalDAV / MQTT-Bridge / REST v2)
        # rumahl-api mounts routes at the root (no /api/<svc>/ prefix), so we
        # forward each well-known path explicitly. Stable surfaces only.
        location /graphql {
            proxy_pass http://rumahl_api;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /webdav {
            client_max_body_size 0;
            proxy_pass http://rumahl_api;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
        }
        location /caldav {
            proxy_pass http://rumahl_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }
        location = /.well-known/caldav {
            proxy_pass http://rumahl_api;
            proxy_set_header Host $host;
        }
        location /api/mqtt/ {
            proxy_pass http://rumahl_api;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location = /api/metrics {
            proxy_pass http://rumahl_api;
            proxy_set_header Host $host;
        }
        location = /api/interfaces {
            proxy_pass http://rumahl_api;
            proxy_set_header Host $host;
        }
        location = /batch {
            proxy_pass http://rumahl_api;
            proxy_set_header Host $host;
        }
        # App Embedding Gateway subdomains (<app-id>.apps.rumahl.local) are
        # handled by rumahl-home through the root location below — no per-app
        # nginx configuration is required (the gateway resolves the runtime
        # target from the app lifecycle on every request).

        # Health check endpoint
        location /nginx-health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }

    # HTTPS server block (optional, for production)
    # server {
    #     listen 443 ssl http2 default_server;
    #     listen [::]:443 ssl http2 default_server;
    #     server_name _;
    #
    #     ssl_certificate /etc/nginx/ssl/cert.pem;
    #     ssl_certificate_key /etc/nginx/ssl/key.pem;
    #     ssl_protocols TLSv1.2 TLSv1.3;
    #     ssl_ciphers HIGH:!aNULL:!MD5;
    #     ssl_prefer_server_ciphers on;
    #
    #     # Same locations as HTTP server block
    # }
}
