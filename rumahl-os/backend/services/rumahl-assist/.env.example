# ORA AI (rumahl Assist) Configuration
# ============================================

# Service Port
PORT=8092

# AI Provider Selection
# Options: openai, anthropic, local, desktop
RUMAHL_AI_PROVIDER=local

# Provider-Specific Configuration
# ---------------------------------

# OpenAI Configuration (when RUMAHL_AI_PROVIDER=openai)
# RUMAHL_AI_API_KEY=sk-your-openai-api-key-here
# RUMAHL_AI_BASE_URL=https://api.openai.com/v1
# RUMAHL_AI_MODEL=gpt-4o-mini

# Anthropic Configuration (when RUMAHL_AI_PROVIDER=anthropic)
# RUMAHL_AI_API_KEY=sk-ant-your-anthropic-api-key-here
# RUMAHL_AI_BASE_URL=https://api.anthropic.com/v1
# RUMAHL_AI_MODEL=claude-3-5-sonnet-20241022
# RUMAHL_AI_API_VERSION=2023-06-01

# Local AI Configuration (when RUMAHL_AI_PROVIDER=local)
# Examples: Ollama, LM Studio, LocalAI
RUMAHL_AI_BASE_URL=http://127.0.0.1:11434
RUMAHL_AI_MODEL=llama3.2

# Desktop AI Configuration (when RUMAHL_AI_PROVIDER=desktop)
# Points to rumahl Desktop proxy (LM Studio via desktop client)
# RUMAHL_AI_BASE_URL=http://127.0.0.1:11435
# RUMAHL_AI_MODEL=local-model

# Logging
RUST_LOG=rumahl_assist=debug,info

# Notes:
# - RUMAHL_AI_PROVIDER determines which AI backend to use
# - For OpenAI and Anthropic, you MUST set RUMAHL_AI_API_KEY
# - For Local and Desktop, API key is optional
# - BASE_URL can be customized for self-hosted or compatible APIs
# - MODEL can be changed to any supported model for the provider
