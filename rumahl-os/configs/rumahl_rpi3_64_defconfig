# Buildroot Configuration for rumahl OS – Raspberry Pi 3 / Zero 2W (64-bit)
# Cross-compiled from x86_64 host. Includes full rumahl package suite.

# ── Build acceleration ───────────────────────────────────────────────
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.rumahl-cache/ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=10G"
BR2_DL_DIR="$(HOME)/.rumahl-cache/dl"
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RUMAHL_PATH)/board/rumahl/patches"

# ── Target Architecture (ARM 64-bit, Cortex-A53 for Pi 3) ───────────
BR2_aarch64=y
BR2_cortex_a53=y

# ── Toolchain ────────────────────────────────────────────────────────
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# ── Kernel ───────────────────────────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RUMAHL_PATH)/board/rumahl/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b"

# Compression
BR2_LINUX_KERNEL_LZ4=y

# ── Bootloader – U-Boot ──────────────────────────────────────────────
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_3"
BR2_TARGET_UBOOT_NEEDS_DTC=y

# ── Raspberry Pi firmware ────────────────────────────────────────────
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_RUMAHL_PATH)/board/rumahl-rpi/config.txt"

# ── System ───────────────────────────────────────────────────────────
BR2_TARGET_GENERIC_HOSTNAME="ora"
BR2_TARGET_GENERIC_ISSUE="Welcome to rumahl OS"
BR2_TARGET_GENERIC_ROOT_PASSWD="ora"
BR2_SYSTEM_DHCP="eth0"

# ── Init system ──────────────────────────────────────────────────────
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# ── Filesystem images ────────────────────────────────────────────────
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="8G"

# ── Required packages ────────────────────────────────────────────────
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BASH_COMPLETION=y

# ── Docker ───────────────────────────────────────────────────────────
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_COMPOSE=y
BR2_PACKAGE_CONTAINERD=y

# ── Network ──────────────────────────────────────────────────────────
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y

# ── Compression ──────────────────────────────────────────────────────
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_LZ4=y
BR2_PACKAGE_XZ=y

# ── Filesystem tools ─────────────────────────────────────────────────
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_SQUASHFS=y
BR2_PACKAGE_ZRAM_TOOLS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_F2FS_TOOLS=y

# ── System utilities ─────────────────────────────────────────────────
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_SCREEN=y
BR2_PACKAGE_DIALOG=y

# ── Boot splash ──────────────────────────────────────────────────────
BR2_PACKAGE_PLYMOUTH=y
BR2_PACKAGE_PLYMOUTH_THEMES=y
BR2_PACKAGE_FBV=y
BR2_PACKAGE_FBSET=y

# ── RPI hardware support ─────────────────────────────────────────────
BR2_PACKAGE_RPI_USERLAND=y
BR2_PACKAGE_RPI_BT_FIRMWARE=y
BR2_PACKAGE_RPI_WIFI_FIRMWARE=y
BR2_PACKAGE_USB_UTILS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_UTIL_LINUX_CFDISK=y
BR2_PACKAGE_UTIL_LINUX_FDISK=y

# ── Python ───────────────────────────────────────────────────────────
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PIP=y

# ── RAUC update ──────────────────────────────────────────────────────
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_SERVICE=y
BR2_PACKAGE_RAUC_NETWORK=y

# ── Security ─────────────────────────────────────────────────────────
BR2_PACKAGE_APPARMOR=y
BR2_PACKAGE_APPARMOR_UTILS=y
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_HAVEGED=y

# ── Database ─────────────────────────────────────────────────────────
BR2_PACKAGE_POSTGRESQL=y

# ── Time sync ────────────────────────────────────────────────────────
BR2_PACKAGE_CHRONY=y

# ── rumahl dev toolchain (only for dev builds) ─────────────────────────
# BR2_PACKAGE_RUMAHL_DEV_TOOLCHAIN is not set

# ── Post-build scripts ───────────────────────────────────────────────
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RUMAHL_PATH)/board/rumahl-rpi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RUMAHL_PATH)/board/rumahl-rpi/post-image.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RUMAHL_PATH)/board/rumahl-rpi/rootfs-overlay"

# External tree
BR2_EXTERNAL_RUMAHL_PATH="$(BR2_EXTERNAL)"

# rumahl Security Center providers
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_CLAMAV=y
BR2_PACKAGE_YARA=y

# rumahl runtime sensor eBPF pipeline
BR2_PACKAGE_LIBBPF=y
BR2_PACKAGE_HOST_CLANG=y
BR2_PACKAGE_HOST_BPFTOOL=y
BR2_PACKAGE_RUMAHL_RUNTIME_SENSOR_EBPF_LOADER=y
