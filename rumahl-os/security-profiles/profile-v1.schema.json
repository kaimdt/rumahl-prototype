{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumahl.local/schemas/security-profile-v1.json",
  "title": "rumahl App Security Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "subject_type", "subject_id", "source", "created_at"],
  "properties": {
    "schema_version": { "const": "ora.security-profile.v1" },
    "profile_id": { "type": "string", "format": "uuid" },
    "profile_version": { "type": "integer", "minimum": 1 },
    "subject_type": { "enum": ["app", "system_service"] },
    "subject_id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["learned", "built_in", "app_manifest", "administrator"] },
    "source_reference": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "processes": { "type": "array", "items": { "$ref": "#/$defs/process" } },
    "executables": { "type": "array", "items": { "$ref": "#/$defs/executable" } },
    "network": { "type": "array", "items": { "$ref": "#/$defs/network" } },
    "filesystem": { "type": "array", "items": { "$ref": "#/$defs/filesystem" } },
    "runtime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "disposition": { "enum": ["observed", "expected", "allowed", "unusual", "forbidden"] },
    "process": { "type": "object", "required": ["name", "disposition"], "properties": { "name": { "type": "string" }, "disposition": { "$ref": "#/$defs/disposition" }, "executable_hashes": { "type": "array", "items": { "type": "string" } } } },
    "executable": { "type": "object", "required": ["path_prefix", "disposition"], "properties": { "path_prefix": { "type": "string" }, "disposition": { "$ref": "#/$defs/disposition" }, "sha256": { "type": "array", "items": { "type": "string" } } } },
    "network": { "type": "object", "required": ["direction", "protocol", "disposition"], "properties": { "direction": { "enum": ["inbound", "outbound"] }, "protocol": { "type": "string" }, "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }, "destination": { "type": ["string", "null"] }, "disposition": { "$ref": "#/$defs/disposition" } } },
    "filesystem": { "type": "object", "required": ["operation", "path_prefix", "disposition"], "properties": { "operation": { "enum": ["read", "write", "execute"] }, "path_prefix": { "type": "string" }, "disposition": { "$ref": "#/$defs/disposition" } } },
    "runtime": { "type": "object", "properties": { "shell_execution": { "$ref": "#/$defs/disposition" }, "interpreter_execution": { "$ref": "#/$defs/disposition" }, "executable_from_tmp": { "$ref": "#/$defs/disposition" }, "child_process_depth": { "type": ["integer", "null"], "minimum": 0 } } }
  }
}
