      "scrollbar-thumb": "var(--border)",
      "scrollbar-thumb-hover": "var(--muted-foreground)",
      "focus-ring-width": "2px",
      "focus-ring-offset": "2px",
      "content-max-width": "1500px",
      "header-height": "56px",
      "nav-icon-size": "20px",
      "badge-radius": "9999px",
      "tooltip-bg": "var(--card)",
      "tooltip-fg": "var(--card-foreground)",
