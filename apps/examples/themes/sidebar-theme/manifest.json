      "input-border": "var(--border)",
      "overlay-bg": "rgba(0,0,0,0.5)",
      "skeleton-shimmer": "rgba(255,255,255,0.05)"
    },
    "additional_css": "/* ─── Sidebar Theme: Additional Styling ─── */\n:root[data-nav-position=\"left\"] [data-nav=\"root\"] {\n  background: oklch(0.16 0.025 260 / 0.95) !important;\n  backdrop-filter: blur(30px) saturate(1.4);\n  border-right: 1px solid oklch(0.35 0.02 260 / 0.2);\n  box-shadow: 2px 0 30px oklch(0 0 0 / 0.3);\n}\n:root[data-nav-position=\"left\"] [data-nav=\"root\"] button { min-height: 48px !important; margin: 2px 4px !important; font-size: 14px !important; }\n:root[data-nav-position=\"left\"] [data-nav=\"root\"] button:hover { background: oklch(0.30 0.03 260 / 0.4) !important; }\n:root[data-nav-position=\"left\"] main { padding-top: 1.5rem !important; }\n:root[data-header-style=\"compact\"] .glass-header { background: oklch(0.20 0.02 260 / 0.6) !important; backdrop-filter: blur(20px); border-bottom: 1px solid oklch(0.30 0.02 260 / 0.15); }\n.glass-card { transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease; }\n.glass-card:hover { border-color: oklch(from var(--accent) l c h / 0.15); transform: translateY(-1px); }\n@media (max-width: 768px) {\n  :root[data-nav-position=\"left\"] { --layout-nav-width: 0px; }\n  :root[data-nav-position=\"left\"] [data-nav=\"root\"] {\n    bottom: 0 !important; top: auto !important; left: 50% !important; right: auto !important;\n    transform: translateX(-50%) !important; width: auto !important; max-width: calc(100vw - 1rem) !important;\n    flex-direction: row !important; border-radius: 9999px !important; border-right: none !important;\n  }\n  :root[data-nav-position=\"left\"] [data-nav=\"root\"] .flex.items-center { flex-direction: row !important; }\n  :root[data-nav-position=\"left\"] [data-nav=\"root\"] > div { flex-direction: row !important; height: auto !important; }\n  :root[data-nav-position=\"left\"] main, :root[data-nav-position=\"left\"] .page-content { padding-left: 1rem !important; }\n  :root[data-nav-position=\"left\"] .glass-header { padding-left: 0 !important; }\n}\n/* ─── Sidebar – Individuelle Scrollbars ─── */\n::-webkit-scrollbar { width: 8px; height: 8px; }\n::-webkit-scrollbar-track { background: var(--muted, oklch(0.25 0.02 260)); border-radius: 4px; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.40 0.025 260)); border-radius: 4px; transition: background var(--transition-duration, 0.4s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--accent, oklch(0.62 0.20 260)); }\n::-webkit-scrollbar-corner { background: var(--muted, oklch(0.25 0.02 260)); }\n/* ─── Textauswahl – Indigo-Highlight ─── */\n::selection { background: var(--selection-bg, oklch(0.62 0.20 260 / 0.25)); color: var(--foreground, oklch(0.85 0.015 260)); }\n/* ─── Fokus-Ringe – Präzise Indigo-Outline ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--ring, oklch(0.62 0.20 260)); outline-offset: 2px; border-radius: 0.3rem; transition: box-shadow var(--transition-duration, 0.4s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--accent); }\n/* ─── Badge/Pill – Sidebar-Tags ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.15em 0.6em; font-family: 'Inter', sans-serif; font-size: 0.7rem; font-weight: 500; border-radius: 10px; background: oklch(from var(--accent) l c h / 0.1); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.18); transition: all var(--transition-duration, 0.4s) ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.2); border-color: oklch(from var(--accent) l c h / 0.4); box-shadow: 0 2px 10px oklch(0 0 0 / 0.15); }\n/* ─── Tooltips – Schwebende Sidebar-Hinweise ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(4px); padding: 0.35rem 0.7rem; font-family: 'Inter', sans-serif; font-size: 0.68rem; font-weight: 400; white-space: nowrap; color: var(--card-foreground, oklch(0.88 0.015 260)); background: var(--card, oklch(0.22 0.025 260)); border: 1px solid var(--border, oklch(0.28 0.015 260)); border-radius: var(--radius, 1rem); box-shadow: 0 8px 24px oklch(0 0 0 / 0.2); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.4s) ease, transform var(--transition-duration, 0.4s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Indigo-Pulsieren ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted, oklch(0.25 0.02 260)) 0%, oklch(from var(--accent) l c h / 0.12) 50%, var(--muted, oklch(0.25 0.02 260)) 100%); background-size: 200% 100%; animation: skeleton-indigo 1.4s ease-in-out infinite; border-radius: var(--radius, 1rem); min-height: 1em; }\n@keyframes skeleton-indigo { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n/* ─── Input/Textarea – Klare Sidebar-Felder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Inter', sans-serif; background: var(--muted, oklch(0.25 0.02 260)); color: var(--foreground, oklch(0.85 0.015 260)); border: 1px solid var(--border, oklch(0.28 0.015 260)); border-radius: 0.6rem; padding: 0.5rem 0.75rem; font-size: 0.82rem; transition: border-color var(--transition-duration, 0.4s) ease, box-shadow var(--transition-duration, 0.4s) ease, background var(--transition-duration, 0.4s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px oklch(from var(--accent) l c h / 0.15); background: var(--card, oklch(0.22 0.025 260)); outline: none; }\ninput::placeholder, textarea::placeholder { color: var(--muted-foreground, oklch(0.55 0.02 260)); }\n/* ─── Smooth Transitions – Sidebar-Fluss ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.4s) ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
