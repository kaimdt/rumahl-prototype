    "id": "sidebar-dark",
    "name": "Sidebar Dark",
    "version": "1.1.0",
    "developer": "IORA",
    "description": "Minimales Dark-Theme mit CSS-getriebener Sidebar-Navigation – elegant und responsive",
    "icon": "Sidebar",
    "preview_image": "images/preview.svg",
