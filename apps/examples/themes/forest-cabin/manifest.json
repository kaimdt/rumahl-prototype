    "additional_css": ".glass-card { border-radius: 1rem; border: 1px solid oklch(0.35 0.05 140 / 0.15); box-shadow: inset 0 1px 0 oklch(1 1 0 / 0.03); }\n.glass-card:hover { border-color: oklch(0.45 0.10 85 / 0.25); box-shadow: 0 8px 30px oklch(0 0 0 / 0.3), inset 0 1px 0 oklch(1 1 0 / 0.05); }\n.glass-header { background: oklch(0.14 0.035 140 / 0.85) !important; backdrop-filter: blur(20px); border-bottom: 1px solid oklch(0.30 0.04 140 / 0.3); }\n[data-nav=\"root\"] { background: oklch(0.14 0.035 140 / 0.9) !important; backdrop-filter: blur(24px); border-top: 1px solid oklch(0.30 0.04 140 / 0.25); }\n/* ─── Individuelle Scrollbars – Holz-Optik ─── */\n::-webkit-scrollbar { width: 10px; height: 10px; }\n::-webkit-scrollbar-track { background: var(--muted, oklch(0.18 0.03 140)); border-radius: 1rem; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.42 0.10 85)); border-radius: 1rem; border: 2px solid var(--muted, oklch(0.18 0.03 140)); transition: background 0.45s ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--accent, oklch(0.52 0.14 85)); }\n::-webkit-scrollbar-corner { background: var(--muted, oklch(0.18 0.03 140)); }\n/* ─── Textauswahl – Laternenlicht-Highlight ─── */\n::selection { background: var(--selection-bg, oklch(0.52 0.14 85 / 0.3)); color: var(--foreground, oklch(0.85 0.025 90)); }\n/* ─── Fokus-Ringe – Moosgrün sanft ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 3px var(--ring, oklch(0.55 0.16 85 / 0.4)); border-radius: 0.3rem; transition: box-shadow 0.45s ease; }\nbutton:focus-visible, a:focus-visible { outline: none !important; box-shadow: 0 0 0 3px var(--accent); }\n/* ─── Badge/Pill – Handgefertigte Holzschildchen ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.2em 0.7em; font-family: 'Nunito', sans-serif; font-size: 0.72rem; font-weight: 500; border-radius: 0.75rem; background: oklch(from var(--accent) l c h / 0.1); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.2); transition: all 0.45s ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.2); border-color: oklch(from var(--accent) l c h / 0.35); box-shadow: 0 2px 12px oklch(0 0 0 / 0.2); }\n/* ─── Tooltips – Handgeschnitzte Hinweise ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(6px); padding: 0.4rem 0.8rem; font-family: 'Lora', serif; font-size: 0.7rem; font-weight: 400; font-style: italic; white-space: nowrap; color: var(--foreground, oklch(0.85 0.025 90)); background: oklch(0.16 0.04 140 / 0.95); border: 1px solid oklch(0.35 0.05 140 / 0.3); border-radius: 0.6rem; box-shadow: 0 4px 20px oklch(0 0 0 / 0.3); opacity: 0; pointer-events: none; transition: opacity 0.45s ease, transform 0.45s ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Flackerndes Kaminlicht ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted, oklch(0.18 0.03 140)) 0%, oklch(from var(--accent) l c h / 0.15) 50%, var(--muted, oklch(0.18 0.03 140)) 100%); background-size: 200% 100%; animation: skeleton-glow 1.8s ease-in-out infinite; border-radius: 0.5rem; min-height: 1em; }\n@keyframes skeleton-glow { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }\n/* ─── Input/Textarea – Rustikale Eingabefelder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Nunito', sans-serif; background: var(--muted, oklch(0.18 0.03 140)); color: var(--foreground, oklch(0.85 0.025 90)); border: 1px solid oklch(0.28 0.04 140); border-radius: 0.6rem; padding: 0.5rem 0.75rem; font-size: 0.82rem; transition: border-color 0.45s ease, box-shadow 0.45s ease, background 0.45s ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 16px oklch(from var(--accent) l c h / 0.2); background: oklch(0.16 0.04 140); outline: none; }\ninput::placeholder, textarea::placeholder { color: oklch(0.42 0.03 90); font-style: italic; }\n/* ─── Smooth Transitions – Alle interaktiven Elemente ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all 0.45s ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n\n/* Forest Cabin – Core CSS */\n:root[data-theme=\"forest-cabin\"] {\n  font-family: 'Lora', 'Georgia', serif;\n}\n\n:root[data-theme=\"forest-cabin\"] h1, \n:root[data-theme=\"forest-cabin\"] h2, \n:root[data-theme=\"forest-cabin\"] h3 {\n  font-family: 'Lora', serif;\n  font-weight: 500;\n}",
