    "additional_css": ".glass-card { border: 2px solid oklch(0.35 0.10 340 / 0.3); }\n.glass-card:hover { border-color: oklch(from var(--accent) l c h / 0.60); box-shadow: 0 0 25px oklch(from var(--accent) l c h / 0.25); }\n[data-nav=\"root\"] { border-top: 2px solid oklch(0.35 0.10 340 / 0.3); }\n.glass-header { background: oklch(0.14 0.05 310 / 0.85) !important; backdrop-filter: blur(24px); border-bottom: 2px solid oklch(0.35 0.10 340 / 0.3); }\n/* ─── Synthwave Sunset – Individuelle Scrollbars im Neon-Look ─── */\n::-webkit-scrollbar { width: 10px; height: 10px; }\n::-webkit-scrollbar-track { background: var(--muted, oklch(0.18 0.05 310)); border: 1px solid oklch(0.30 0.08 340 / 0.3); border-radius: 4px; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.50 0.22 340)); border-radius: 4px; box-shadow: 0 0 10px oklch(0.62 0.28 340 / 0.4); transition: background var(--transition-duration, 0.3s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--accent, oklch(0.62 0.28 340)); box-shadow: 0 0 18px oklch(0.62 0.28 340 / 0.6); }\n::-webkit-scrollbar-corner { background: var(--muted, oklch(0.18 0.05 310)); }\n/* ─── Textauswahl – Neon-Pink Highlight ─── */\n::selection { background: var(--selection-bg, oklch(0.62 0.28 340 / 0.35)); color: var(--foreground, oklch(0.88 0.04 70)); text-shadow: 0 0 8px oklch(0.62 0.28 340 / 0.4); }\n/* ─── Fokus-Ringe – Neon-Outline ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--background, oklch(0.12 0.05 310)), 0 0 0 4px var(--ring, oklch(0.65 0.28 340)); border-radius: 2px; transition: box-shadow var(--transition-duration, 0.3s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--background), 0 0 0 4px var(--accent); }\n/* ─── Badge/Pill – Neon-Tags ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.15em 0.6em; font-family: 'Rajdhani', sans-serif; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 3px; background: oklch(from var(--accent) l c h / 0.1); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.3); transition: all var(--transition-duration, 0.3s) ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.2); border-color: oklch(from var(--accent) l c h / 0.55); box-shadow: 0 0 16px oklch(from var(--accent) l c h / 0.3); }\n/* ─── Tooltips – Retro-Overlay ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(4px); padding: 0.35rem 0.75rem; font-family: 'Rajdhani', sans-serif; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; color: oklch(0.90 0.04 70); background: oklch(0.12 0.05 310 / 0.95); border: 2px solid oklch(from var(--accent) l c h / 0.5); border-radius: 3px; box-shadow: 0 0 20px oklch(from var(--accent) l c h / 0.2), 0 0 40px oklch(0 0 0 / 0.4); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.3s) ease, transform var(--transition-duration, 0.3s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Neon-Pulse ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted, oklch(0.18 0.05 310)) 0%, oklch(from var(--accent) l c h / 0.18) 50%, var(--muted, oklch(0.18 0.05 310)) 100%); background-size: 200% 100%; animation: skeleton-neon 1s ease-in-out infinite; border-radius: var(--radius, 4px); min-height: 1em; }\n@keyframes skeleton-neon { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n/* ─── Input/Textarea – Retro-Eingabefelder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Rajdhani', sans-serif; background: var(--muted, oklch(0.18 0.05 310)); color: var(--foreground, oklch(0.88 0.04 70)); border: 2px solid oklch(0.30 0.08 340 / 0.4); border-radius: var(--radius, 4px); padding: 0.5rem 0.75rem; font-size: 0.85rem; letter-spacing: 0.03em; transition: border-color var(--transition-duration, 0.3s) ease, box-shadow var(--transition-duration, 0.3s) ease, background var(--transition-duration, 0.3s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px oklch(from var(--accent) l c h / 0.2), 0 0 20px oklch(from var(--accent) l c h / 0.15); background: oklch(0.14 0.055 310); outline: none; }\ninput::placeholder, textarea::placeholder { color: oklch(0.45 0.06 310); font-style: italic; }\n/* ─── Smooth Transitions – 80s-Retro-Flow ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.3s) ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
