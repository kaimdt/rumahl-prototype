    "additional_css": "/* ─── Steampunk – Individuelle Scrollbars mit Messing-Optik ─── */\n::-webkit-scrollbar { width: var(--scrollbar-width, 10px); height: var(--scrollbar-width, 10px); }\n::-webkit-scrollbar-track { background: var(--scrollbar-track, oklch(0.22 0.025 85)); border: 1px solid oklch(0.45 0.08 80 / 0.3); border-radius: 3px; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.50 0.14 85)); border-radius: 3px; border: 1px solid oklch(0.55 0.16 85 / 0.4); transition: background var(--transition-duration, 0.5s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-thumb-hover, oklch(0.62 0.18 85)); }\n::-webkit-scrollbar-corner { background: var(--scrollbar-track, oklch(0.22 0.025 85)); }\n/* ─── Textauswahl – Vergilbtes Pergament ─── */\n::selection { background: var(--selection-bg, oklch(0.62 0.18 85 / 0.3)); color: var(--selection-fg, var(--foreground)); }\n/* ─── Fokus-Ringe – Gravierter Messing-Rahmen ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 var(--focus-ring-width, 2px) oklch(0.35 0.03 80), 0 0 0 calc(var(--focus-ring-width, 2px) + 2px) var(--accent); outline-offset: var(--focus-ring-offset, 2px); border-radius: 2px; transition: box-shadow var(--transition-duration, 0.5s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 2px oklch(0.30 0.025 80), 0 0 0 4px var(--accent); }\n/* ─── Badge/Pill – Gravierte Messing-Plaketten ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.15em 0.6em; font-family: 'IM Fell English', serif; font-size: 0.7rem; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; border-radius: var(--badge-radius, 3px); background: oklch(0.30 0.04 80 / 0.6); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.35); transition: all var(--transition-duration, 0.5s) ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.15); border-color: oklch(from var(--accent) l c h / 0.55); box-shadow: 0 2px 8px oklch(0 0 0 / 0.3), inset 0 0 8px oklch(from var(--accent) l c h / 0.1); }\n/* ─── Tooltips – Viktorianische Notizzettel ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%) translateY(6px); padding: 0.4rem 0.85rem; font-family: 'IM Fell English', serif; font-size: 0.72rem; font-weight: 400; font-style: italic; white-space: nowrap; color: var(--tooltip-fg, var(--foreground)); background: var(--tooltip-bg, oklch(0.28 0.04 80)); border: 1px solid oklch(from var(--accent) l c h / 0.35); border-radius: 3px; box-shadow: 0 6px 20px oklch(0 0 0 / 0.4); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.5s) ease, transform var(--transition-duration, 0.5s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Tickende Uhrwerk-Animation ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted) 0%, oklch(from var(--accent) l c h / 0.12) 50%, var(--muted) 100%); background-size: 200% 100%; animation: skeleton-tick 2s steps(4) infinite; border-radius: var(--radius, 3px); min-height: 1em; }\n@keyframes skeleton-tick { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n/* ─── Input/Textarea – Schreibmaschinen-Felder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Courier Prime', monospace; background: var(--input-bg, var(--muted)); color: var(--foreground); border: 2px solid oklch(0.45 0.08 80 / 0.4); border-radius: 3px; padding: 0.5rem 0.75rem; font-size: 0.8rem; letter-spacing: 0.03em; transition: border-color var(--transition-duration, 0.5s) ease, box-shadow var(--transition-duration, 0.5s) ease, background var(--transition-duration, 0.5s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 2px oklch(from var(--accent) l c h / 0.2); background: oklch(0.24 0.03 80); outline: none; }\ninput::placeholder, textarea::placeholder { color: var(--muted-foreground); font-family: 'IM Fell English', serif; font-style: italic; }\n/* ─── Smooth Transitions – Dampfmaschinen-Rhythmus ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.5s) ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
