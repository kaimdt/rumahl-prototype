      {
        "id": "steampunk-day",
        "name": "Steam Day",
        "icon": "Sun",
        "time_start": "06:00",
        "time_end": "17:00",
        "css_variables": {
          "background": "oklch(0.22 0.03 85)",
          "foreground": "oklch(0.88 0.04 85)",
          "card": "oklch(0.26 0.035 80)",
          "accent": "oklch(0.62 0.18 85)",
