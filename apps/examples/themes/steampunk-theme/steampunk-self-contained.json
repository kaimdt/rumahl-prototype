          "glass-border-color": "oklch(0.52 0.14 65 / 0.22)"
        }
      },
      {
        "id": "steampunk-night",
        "name": "Midnight Factory",
        "icon": "MoonStars",
        "time_start": "22:00",
        "time_end": "06:00",
        "css_variables": {
          "background": "oklch(0.12 0.015 70)",
          "foreground": "oklch(0.75 0.03 70)",
          "card": "oklch(0.16 0.02 65)",
          "accent": "oklch(0.50 0.15 65)",
          "muted": "oklch(0.18 0.015 65)",
          "border": "oklch(0.30 0.06 65)",
          "glass-bg": "oklch(0.22 0.025 65 / 0.4)",
          "glass-bg-end": "oklch(0.16 0.015 60 / 0.3)",
          "glass-border-color": "oklch(0.38 0.08 65 / 0.18)"
        }
      }
    ],
    "auto_behavior": {
      "mode": "time",
      "time_ranges": {
        "steampunk-day": {
          "start": "06:00",
          "end": "17:00"
        },
        "steampunk-evening": {
          "start": "17:00",
          "end": "22:00"
        },
        "steampunk-night": {
          "start": "22:00",
          "end": "06:00"
        }
      },
      "default_mode": "steampunk-day"
    },
    "accent_control": {
      "mode": "presets",
      "presets": [
        {
          "name": "Messing (Standard)",
          "color": "oklch(0.62 0.18 85)"
        },
        {
          "name": "Kupfer",
          "color": "oklch(0.55 0.20 50)"
        },
        {
          "name": "Bronze",
          "color": "oklch(0.50 0.16 70)"
        },
        {
          "name": "Rose Gold",
          "color": "oklch(0.58 0.16 30)"
        },
        {
          "name": "Oxidiertes Kupfer",
          "color": "oklch(0.48 0.12 180)"
        }
      ]
    },
    "glass_control": {
      "mode": "force_values",
      "blur": "24px",
      "opacity": "0.7"
    },
    "custom_settings": [
      {
        "id": "steam_particles",
        "name": "Dampf-Partikel",
        "description": "Animierte Dampfschwaden im Hintergrund",
        "setting_type": "toggle",
        "default_value": true
      },
      {
        "id": "gear_animation_speed",
        "name": "Zahnrad-Geschwindigkeit",
        "description": "Rotationsgeschwindigkeit der dekorativen Zahnräder",
        "setting_type": "select",
        "default_value": "normal",
        "options": [
          {
            "label": "Langsam",
            "value": "slow"
          },
          {
            "label": "Normal",
            "value": "normal"
          },
          {
            "label": "Schnell",
            "value": "fast"
          }
        ],
        "css_variable": "steampunk-gear-speed"
      },
      {
        "id": "vignette_intensity",
        "name": "Vignette-Effekt",
        "description": "Abdunkelung an den Bildrändern (viktorianischer Look)",
        "setting_type": "slider",
        "default_value": 60,
        "min": 0,
        "max": 100,
        "step": 10,
        "css_variable": "steampunk-vignette"
      },
      {
        "id": "brass_borders",
        "name": "Messing-Rahmen",
        "description": "Dekorative Messing-Umrandung um Karten",
        "setting_type": "toggle",
        "default_value": true,
        "css_variable": "steampunk-brass-borders"
      },
      {
        "id": "typewriter_sounds",
        "name": "Schreibmaschinen-Sound",
        "description": "Dezentes Klickgeräusch bei Texteingabe",
        "setting_type": "toggle",
        "default_value": false
      }
    ]
  },
