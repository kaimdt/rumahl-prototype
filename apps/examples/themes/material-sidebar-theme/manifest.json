        "format": "woff2"
      },
      {
        "name": "Roboto Mono",
        "family": "'Roboto Mono', 'JetBrains Mono', monospace",
        "url": "fonts/roboto-mono.css",
        "weights": "300;400;500",
        "subsets": "latin",
        "is_primary": false,
        "is_heading": false,
        "is_monospace": true,
        "format": "woff2"
      }
    ]
  }
