    "additional_css": "/* ─── Ozean – Individuelle Scrollbars wie Meereswellen ─── */\n::-webkit-scrollbar { width: var(--scrollbar-width, 8px); height: var(--scrollbar-width, 8px); }\n::-webkit-scrollbar-track { background: var(--scrollbar-track, transparent); border-radius: 4px; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.25 0.06 250)); border-radius: 4px; transition: background var(--transition-duration, 0.5s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-thumb-hover, var(--accent)); }\n::-webkit-scrollbar-corner { background: var(--scrollbar-track, transparent); }\n/* ─── Textauswahl – Türkises Meeresleuchten ─── */\n::selection { background: var(--selection-bg, oklch(0.60 0.25 220 / 0.3)); color: var(--selection-fg, var(--foreground)); }\n/* ─── Fokus-Ringe – Sanfte Meereswelle ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 var(--focus-ring-width, 2px) var(--ring, oklch(0.65 0.25 220)); outline-offset: var(--focus-ring-offset, 2px); border-radius: 0.3rem; transition: box-shadow var(--transition-duration, 0.5s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 var(--focus-ring-width, 2px) var(--accent); }\n/* ─── Badge/Pill – Blasen-Tags ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.2em 0.65em; font-family: 'DM Sans', sans-serif; font-size: 0.7rem; font-weight: 500; border-radius: var(--badge-radius, 9999px); background: oklch(from var(--accent) l c h / 0.1); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.18); transition: all var(--transition-duration, 0.5s) ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.2); border-color: oklch(from var(--accent) l c h / 0.35); box-shadow: 0 4px 16px oklch(from var(--accent) l c h / 0.15); }\n/* ─── Tooltips – Auftauchende Meeresblasen ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%) translateY(6px); padding: 0.4rem 0.8rem; font-family: 'Spectral', serif; font-size: 0.7rem; font-weight: 400; font-style: italic; white-space: nowrap; color: var(--tooltip-fg, var(--card-foreground)); background: var(--tooltip-bg, var(--card)); border: 1px solid oklch(from var(--accent) l c h / 0.25); border-radius: var(--radius, 0.85rem); box-shadow: var(--shadow-lg, 0 10px 30px rgba(0,0,0,0.25)); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.5s) ease, transform var(--transition-duration, 0.5s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Sanftes Wellen-Pulsieren ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted) 0%, var(--skeleton-shimmer, rgba(255,255,255,0.05)) 50%, var(--muted) 100%); background-size: 200% 100%; animation: skeleton-wave 2s ease-in-out infinite; border-radius: var(--radius, 0.85rem); min-height: 1em; }\n@keyframes skeleton-wave { 0% { background-position: 200% 0; opacity: 0.5; } 50% { opacity: 1; } 100% { background-position: -200% 0; opacity: 0.5; } }\n/* ─── Input/Textarea – Ozean-Eingabefelder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'DM Sans', sans-serif; background: var(--input-bg, var(--muted)); color: var(--foreground); border: 1px solid var(--input-border, var(--border)); border-radius: 0.6rem; padding: 0.5rem 0.75rem; font-size: 0.82rem; transition: border-color var(--transition-duration, 0.5s) ease, box-shadow var(--transition-duration, 0.5s) ease, background var(--transition-duration, 0.5s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px oklch(from var(--accent) l c h / 0.2), 0 8px 24px oklch(from var(--accent) l c h / 0.1); background: var(--card); outline: none; }\ninput::placeholder, textarea::placeholder { color: var(--muted-foreground); font-style: italic; }\n/* ─── Smooth Transitions – Fließende Wellen ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.5s) ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n\n/* Ocean Blue Theme – CSS Variables */\n:root {\n  --background: oklch(0.06 0.04 250);\n  --foreground: oklch(0.88 0.03 220);\n  --card: oklch(0.1 0.05 250);\n  --card-foreground: oklch(0.85 0.03 220);\n  --popover: oklch(0.1 0.05 250);\n  --popover-foreground: oklch(0.85 0.03 220);\n  --primary: oklch(0.6 0.25 220);\n  --primary-foreground: oklch(0.98 0 0);\n  --secondary: oklch(0.15 0.04 250);\n  --secondary-foreground: oklch(0.85 0.03 220);\n  --muted: oklch(0.12 0.04 250);\n  --muted-foreground: oklch(0.5 0.04 220);\n  --accent: oklch(0.6 0.25 220);\n  --accent-foreground: oklch(0.98 0 0);\n  --destructive: oklch(0.52 0.24 25);\n  --success: oklch(0.55 0.18 140);\n  --border: oklch(0.18 0.05 250);\n  --input: oklch(0.18 0.04 250);\n  --ring: oklch(0.6 0.25 220);\n  --radius: 0.85rem;\n  --glass-bg: oklch(0.1 0.05 250 / 0.6);\n}",
