    "additional_css": ".glass-card { box-shadow: 0 2px 12px oklch(0 0 0 / 0.04), 0 1px 3px oklch(0 0 0 / 0.02); }\n.glass-card:hover { box-shadow: 0 8px 30px oklch(0 0 0 / 0.06), 0 2px 6px oklch(0 0 0 / 0.03); transform: translateY(-2px); }\nbutton, .glass-card-interactive { transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); }\n.glass-header { background: oklch(0.99 0.003 85 / 0.8) !important; backdrop-filter: blur(16px); border-bottom: 1px solid oklch(0.86 0.008 85); }\n/* ─── Nordic Light – Individuelle Scrollbars in warmen Naturtönen ─── */\n::-webkit-scrollbar { width: 10px; height: 10px; }\n::-webkit-scrollbar-track { background: var(--muted, oklch(0.92 0.008 85)); border-radius: 1rem; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.75 0.02 85)); border-radius: 1rem; border: 2px solid var(--muted, oklch(0.92 0.008 85)); transition: background var(--transition-duration, 0.5s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--accent, oklch(0.48 0.08 75)); }\n::-webkit-scrollbar-corner { background: var(--muted, oklch(0.92 0.008 85)); }\n/* ─── Textauswahl – Warmer Holzton ─── */\n::selection { background: var(--selection-bg, oklch(0.48 0.08 75 / 0.2)); color: var(--foreground, oklch(0.25 0.02 85)); }\n/* ─── Fokus-Ringe – Sanfter Natur-Rahmen ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 3px var(--ring, oklch(0.52 0.10 75 / 0.35)); border-radius: 0.4rem; transition: box-shadow var(--transition-duration, 0.5s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 3px var(--accent, oklch(0.48 0.08 75)); }\n/* ─── Badge/Pill – Skandinavische Labels ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.2em 0.7em; font-family: 'Work Sans', sans-serif; font-size: 0.72rem; font-weight: 400; border-radius: 1rem; background: oklch(from var(--accent) l c h / 0.08); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.15); transition: all var(--transition-duration, 0.5s) ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.18); border-color: oklch(from var(--accent) l c h / 0.3); }\n/* ─── Tooltips – Leinen-Stoffhinweise ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%) translateY(6px); padding: 0.4rem 0.85rem; font-family: 'Work Sans', sans-serif; font-size: 0.72rem; font-weight: 400; white-space: nowrap; color: var(--card-foreground, oklch(0.22 0.02 85)); background: oklch(0.99 0.003 85 / 0.95); border: 1px solid oklch(0.86 0.008 85); border-radius: var(--radius, 1.25rem); box-shadow: 0 4px 24px oklch(0 0 0 / 0.06); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.5s) ease, transform var(--transition-duration, 0.5s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Sanftes Leinen-Atmen ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted, oklch(0.92 0.008 85)) 0%, oklch(0.96 0.005 85) 50%, var(--muted, oklch(0.92 0.008 85)) 100%); background-size: 200% 100%; animation: skeleton-linen 2s ease-in-out infinite; border-radius: var(--radius, 1.25rem); min-height: 1em; }\n@keyframes skeleton-linen { 0% { opacity: 0.5; background-position: 200% 0; } 50% { opacity: 1; } 100% { opacity: 0.5; background-position: -200% 0; } }\n/* ─── Input/Textarea – Natürliche Eingabefelder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Work Sans', sans-serif; background: var(--card, oklch(0.99 0.003 85)); color: var(--foreground, oklch(0.25 0.02 85)); border: 1px solid var(--border, oklch(0.86 0.008 85)); border-radius: 0.8rem; padding: 0.55rem 0.8rem; font-size: 0.85rem; transition: border-color var(--transition-duration, 0.5s) ease, box-shadow var(--transition-duration, 0.5s) ease, background var(--transition-duration, 0.5s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent, oklch(0.48 0.08 75)); box-shadow: 0 0 0 3px oklch(from var(--accent) l c h / 0.15); background: oklch(1 0 0); outline: none; }\ninput::placeholder, textarea::placeholder { color: var(--muted-foreground, oklch(0.50 0.02 85)); font-weight: 300; }\n/* ─── Smooth Transitions – Skandinavische Ruhe ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.5s) cubic-bezier(0.16, 1, 0.3, 1); }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
