    "additional_css": "/* ─── Cyberpunk Neon ─── */\n.glass-card { border-width: 1px !important; text-transform: uppercase; letter-spacing: 0.05em; }\n.glass-card:hover { border-color: oklch(from var(--accent) l c h / 0.50) !important; box-shadow: 0 0 20px oklch(from var(--accent) l c h / 0.20), 0 0 40px oklch(from var(--accent) l c h / 0.08); }\n.glass-header { border-bottom: 1px solid oklch(0.25 0.15 0 / 0.3) !important; background: oklch(0.06 0.005 290 / 0.85) !important; backdrop-filter: blur(24px); }\n[data-nav=\"root\"] { border-top: 1px solid oklch(0.25 0.15 0 / 0.3) !important; }\n[data-nav=\"root\"] button[data-active=\"true\"] { color: var(--accent) !important; text-shadow: 0 0 12px oklch(from var(--accent) l c h / 0.4); }\nbutton, a { transition: all 0.15s ease; }\nbutton:hover, a:hover { filter: brightness(1.3); }\n/* ─── Individuelle Scrollbars – Cyberpunk-Glitch ─── */\n::-webkit-scrollbar { width: 8px; height: 8px; }\n::-webkit-scrollbar-track { background: var(--muted, oklch(0.10 0.008 290)); border: 1px solid oklch(0.18 0.02 290 / 0.5); }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.55 0.22 0)); border-radius: var(--radius, 2px); box-shadow: 0 0 8px oklch(0.65 0.28 0 / 0.4); transition: background 0.15s ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--accent, oklch(0.65 0.28 0)); box-shadow: 0 0 14px oklch(0.65 0.28 0 / 0.6); }\n::-webkit-scrollbar-corner { background: var(--muted, oklch(0.10 0.008 290)); }\n/* ─── Textauswahl – Neon-Highlight ─── */\n::selection { background: var(--selection-bg, oklch(0.65 0.28 0 / 0.35)); color: var(--foreground, oklch(0.90 0.02 290)); text-shadow: 0 0 6px oklch(0.65 0.28 0 / 0.5); }\n/* ─── Fokus-Ringe – Neon-Glow statt Outline ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--background, oklch(0.05 0.005 290)), 0 0 0 4px var(--ring, oklch(0.70 0.28 0)); border-radius: 1px; transition: box-shadow 0.15s ease; }\nbutton:focus-visible, a:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--background), 0 0 0 4px var(--accent); filter: brightness(1.2); }\n/* ─── Badge/Pill – Neon-Tags ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.15em 0.6em; font-family: 'Share Tech Mono', monospace; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; border-radius: var(--radius, 2px); background: oklch(from var(--accent) l c h / 0.12); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.3); transition: all 0.15s ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.22); border-color: oklch(from var(--accent) l c h / 0.55); box-shadow: 0 0 12px oklch(from var(--accent) l c h / 0.25); }\n/* ─── Tooltips – Terminal-Style ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(4px); padding: 0.35rem 0.7rem; font-family: 'Share Tech Mono', monospace; font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; color: oklch(0.90 0.02 290); background: oklch(0.08 0.008 290 / 0.95); border: 1px solid oklch(from var(--accent) l c h / 0.4); border-radius: var(--radius, 2px); box-shadow: 0 0 16px oklch(0 0 0 / 0.5); opacity: 0; pointer-events: none; transition: opacity 0.15s ease, transform 0.15s ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Neon-Pulse ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted, oklch(0.10 0.008 290)) 0%, oklch(from var(--accent) l c h / 0.15) 50%, var(--muted, oklch(0.10 0.008 290)) 100%); background-size: 200% 100%; animation: skeleton-shimmer 1.2s ease-in-out infinite; border-radius: var(--radius, 2px); min-height: 1em; }\n@keyframes skeleton-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n/* ─── Input/Textarea – Terminal-Felder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Share Tech Mono', monospace; background: var(--muted, oklch(0.10 0.008 290)); color: var(--foreground, oklch(0.90 0.02 290)); border: 1px solid oklch(0.22 0.025 0); border-radius: var(--radius, 2px); padding: 0.45rem 0.65rem; font-size: 0.8rem; letter-spacing: 0.04em; transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 12px oklch(from var(--accent) l c h / 0.25); background: oklch(0.08 0.008 290); outline: none; }\ninput::placeholder, textarea::placeholder { color: oklch(0.40 0.015 290); font-style: italic; }\n/* ─── Smooth Transitions – Alle interaktiven Elemente ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all 0.15s ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
