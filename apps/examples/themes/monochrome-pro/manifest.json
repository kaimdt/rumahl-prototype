    "additional_css": ".glass-card { border: 1px solid oklch(0.28 0 0 / 0.20); }\n.glass-card:hover { border-color: oklch(0.40 0 0 / 0.35); box-shadow: 0 6px 24px oklch(0 0 0 / 0.25); }\nbutton:focus-visible, input:focus-visible { outline: 2px solid oklch(0.60 0 0); outline-offset: 2px; }\n.glass-header { background: oklch(0.14 0 0 / 0.85) !important; backdrop-filter: blur(16px); border-bottom: 1px solid oklch(0.24 0 0 / 0.30); }\n/* ─── Monochrome – Individuelle Scrollbars mit Graustufen ─── */\n::-webkit-scrollbar { width: 8px; height: 8px; }\n::-webkit-scrollbar-track { background: var(--muted, oklch(0.20 0 0)); border-radius: 4px; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, oklch(0.35 0 0)); border-radius: 4px; transition: background var(--transition-duration, 0.3s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--accent, oklch(0.55 0 0)); }\n::-webkit-scrollbar-corner { background: var(--muted, oklch(0.20 0 0)); }\n/* ─── Textauswahl – Klares Grau-Highlight ─── */\n::selection { background: var(--selection-bg, oklch(0.55 0 0 / 0.25)); color: var(--foreground, oklch(0.88 0 0)); }\n/* ─── Fokus-Ringe – Funktionale Klarheit ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--ring, oklch(0.60 0 0)); outline-offset: 2px; border-radius: 0.2rem; transition: box-shadow var(--transition-duration, 0.3s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 2px var(--accent); }\n/* ─── Badge/Pill – Minimalistische Tags ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.15em 0.55em; font-family: 'DM Sans', sans-serif; font-size: 0.68rem; font-weight: 500; border-radius: 5px; background: oklch(0.50 0 0 / 0.12); color: var(--accent, oklch(0.55 0 0)); border: 1px solid oklch(0.50 0 0 / 0.2); transition: all var(--transition-duration, 0.3s) ease; }\n.badge:hover, .pill:hover { background: oklch(0.50 0 0 / 0.22); border-color: oklch(0.50 0 0 / 0.4); }\n/* ─── Tooltips – Reduzierte Hinweise ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(4px); padding: 0.35rem 0.7rem; font-family: 'DM Sans', sans-serif; font-size: 0.68rem; font-weight: 400; white-space: nowrap; color: var(--card-foreground, oklch(0.90 0 0)); background: var(--card, oklch(0.16 0 0)); border: 1px solid var(--border, oklch(0.24 0 0)); border-radius: var(--radius, 6px); box-shadow: 0 6px 20px oklch(0 0 0 / 0.25); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.3s) ease, transform var(--transition-duration, 0.3s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Dezentes Grau-Pulsieren ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted, oklch(0.20 0 0)) 0%, oklch(0.30 0 0) 50%, var(--muted, oklch(0.20 0 0)) 100%); background-size: 200% 100%; animation: skeleton-fade 1.4s ease-in-out infinite; border-radius: var(--radius, 6px); min-height: 1em; }\n@keyframes skeleton-fade { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }\n/* ─── Input/Textarea – Klare Eingabefelder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'DM Sans', sans-serif; background: var(--muted, oklch(0.20 0 0)); color: var(--foreground, oklch(0.88 0 0)); border: 1px solid var(--border, oklch(0.24 0 0)); border-radius: var(--radius, 6px); padding: 0.5rem 0.75rem; font-size: 0.82rem; transition: border-color var(--transition-duration, 0.3s) ease, box-shadow var(--transition-duration, 0.3s) ease, background var(--transition-duration, 0.3s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent, oklch(0.55 0 0)); box-shadow: 0 0 0 3px oklch(0.50 0 0 / 0.15); background: var(--card, oklch(0.16 0 0)); outline: none; }\ninput::placeholder, textarea::placeholder { color: var(--muted-foreground, oklch(0.55 0 0)); }\n/* ─── Smooth Transitions – Alle interaktiven Elemente ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.3s) ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
