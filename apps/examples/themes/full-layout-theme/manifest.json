      "muted": "oklch(0.22 0.02 260)",
      "muted-foreground": "oklch(0.52 0.02 260)",
      "border": "oklch(0.26 0.015 260)",
      "ring": "oklch(0.65 0.22 195)",
      "radius": "8px",
      "glass-bg": "oklch(0.20 0.03 260 / 0.55)",
      "glass-bg-end": "oklch(0.16 0.02 260 / 0.45)",
      "glass-border-color": "oklch(0.35 0.02 260 / 0.12)",
      "glass-shadow-1": "oklch(0 0 0 / 0.18)",
      "glass-shadow-2": "oklch(0 0 0 / 0.10)",
