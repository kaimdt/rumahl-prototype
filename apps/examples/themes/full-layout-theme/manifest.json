    "name": "Three Column Dark",
    "version": "1.1.0",
    "developer": "IORA",
    "description": "Dreispaltiges Profi-Layout mit HTML-Template – maximaler Screen-Real-Estate für Power-User",
    "icon": "Columns",
    "preview_image": "images/preview.svg",
    "parent_theme": "night",
    "source": "file",
    "order": 70,
    "css_files": [],
    "js_files": [
