      "shadow-md": "0 4px 6px rgba(255,255,255,0.05)",
      "shadow-lg": "0 10px 25px rgba(255,255,255,0.08)",
      "shadow-xl": "0 20px 50px rgba(255,255,255,0.08)",
      "selection-bg": "var(--accent)",
      "selection-fg": "var(--accent-foreground)",
      "scrollbar-width": "6px",
      "scrollbar-track": "transparent",
      "scrollbar-thumb": "var(--border)",
      "scrollbar-thumb-hover": "var(--muted-foreground)",
      "focus-ring-width": "2px",
      "focus-ring-offset": "2px",
      "content-max-width": "1500px",
      "header-height": "56px",
      "nav-icon-size": "20px",
      "badge-radius": "9999px",
      "tooltip-bg": "var(--card)",
      "tooltip-fg": "var(--card-foreground)",
      "input-bg": "var(--muted)",
      "input-border": "var(--border)",
      "overlay-bg": "rgba(0,0,0,0.5)",
      "skeleton-shimmer": "rgba(255,255,255,0.05)"
    },
    "additional_css": "/* ─── Layout-Übergänge – Spalten-Resize & Panel-Animation ─── */\n[data-layout=\"three-col\"] .column { transition: width var(--transition-duration, 0.35s) ease, opacity var(--transition-duration, 0.35s) ease; }\n[data-layout=\"three-col\"] .sidebar-panel { transition: transform var(--transition-duration, 0.35s) ease, opacity var(--transition-duration, 0.35s) ease; }\n/* ─── Individuelle Scrollbars – Schlanke Profi-Scrollbars ─── */\n::-webkit-scrollbar { width: var(--scrollbar-width, 8px); height: var(--scrollbar-width, 8px); }\n::-webkit-scrollbar-track { background: var(--scrollbar-track, transparent); border-radius: 4px; }\n::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb, var(--border)); border-radius: 4px; transition: background var(--transition-duration, 0.35s) ease; }\n::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-thumb-hover, var(--muted-foreground)); }\n::-webkit-scrollbar-corner { background: var(--scrollbar-track, transparent); }\n/* ─── Textauswahl – Dezentes Cyan-Highlight ─── */\n::selection { background: var(--selection-bg, oklch(0.65 0.22 195 / 0.25)); color: var(--selection-fg, var(--accent-foreground)); }\n/* ─── Fokus-Ringe – Präzise Outline für interaktive Elemente ─── */\n:focus-visible { outline: none !important; box-shadow: 0 0 0 var(--focus-ring-width, 2px) var(--ring, oklch(0.65 0.22 195)); outline-offset: var(--focus-ring-offset, 2px); border-radius: 0.25rem; transition: box-shadow var(--transition-duration, 0.35s) ease; }\nbutton:focus-visible, a:focus-visible, [role=\"button\"]:focus-visible { outline: none !important; box-shadow: 0 0 0 var(--focus-ring-width, 2px) var(--accent); }\n/* ─── Badge/Pill – Professionelle Tags ─── */\n.badge, .pill { display: inline-flex; align-items: center; padding: 0.15em 0.55em; font-family: 'Inter', sans-serif; font-size: 0.68rem; font-weight: 500; border-radius: var(--badge-radius, 9999px); background: oklch(from var(--accent) l c h / 0.1); color: var(--accent); border: 1px solid oklch(from var(--accent) l c h / 0.18); transition: all var(--transition-duration, 0.35s) ease; }\n.badge:hover, .pill:hover { background: oklch(from var(--accent) l c h / 0.2); border-color: oklch(from var(--accent) l c h / 0.4); }\n/* ─── Tooltips – Klare, schwebende Hinweise ─── */\n.tooltip { position: relative; }\n.tooltip::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(4px); padding: 0.35rem 0.7rem; font-family: 'Inter', sans-serif; font-size: 0.68rem; font-weight: 400; white-space: nowrap; color: var(--tooltip-fg, var(--card-foreground)); background: var(--tooltip-bg, var(--card)); border: 1px solid var(--border); border-radius: var(--radius, 8px); box-shadow: var(--shadow-lg, 0 10px 25px rgba(0,0,0,0.2)); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration, 0.35s) ease, transform var(--transition-duration, 0.35s) ease; z-index: 9999; }\n.tooltip:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }\n/* ─── Skeleton Loading – Elegantes Pulsieren ─── */\n.skeleton { background: linear-gradient(90deg, var(--muted) 0%, var(--skeleton-shimmer, rgba(255,255,255,0.05)) 50%, var(--muted) 100%); background-size: 200% 100%; animation: skeleton-drift 1.4s ease-in-out infinite; border-radius: var(--radius, 8px); min-height: 1em; }\n@keyframes skeleton-drift { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n/* ─── Input/Textarea – Klare Eingabefelder ─── */\ninput[type=\"text\"], input[type=\"search\"], input[type=\"number\"], input[type=\"password\"], textarea, select { font-family: 'Inter', sans-serif; background: var(--input-bg, var(--muted)); color: var(--foreground); border: 1px solid var(--input-border, var(--border)); border-radius: var(--radius, 8px); padding: 0.5rem 0.75rem; font-size: 0.82rem; transition: border-color var(--transition-duration, 0.35s) ease, box-shadow var(--transition-duration, 0.35s) ease, background var(--transition-duration, 0.35s) ease; }\ninput:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px oklch(from var(--accent) l c h / 0.15); background: var(--card); outline: none; }\ninput::placeholder, textarea::placeholder { color: var(--muted-foreground); }\n/* ─── Smooth Transitions – Alle interaktiven Elemente ─── */\nbutton, a, input, select, textarea, .badge, .pill, .tooltip, .skeleton, .glass-card, [role=\"button\"], .clickable { transition: all var(--transition-duration, 0.35s) ease; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; } }\n",
