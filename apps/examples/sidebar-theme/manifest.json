{
  "id": "sidebar-theme",
  "name": "Sidebar Navigation",
  "version": "1.1.0",
  "developer": "IORA",
  "description": "Minimalistisches Dark-Theme mit CSS-getriebener Sidebar-Navigation links. Zeigt wie CSS-Variablen das komplette Layout transformieren – ohne JavaScript.",
  "icon": "Sidebar",
  "preview_image": "images/preview.svg",
  "type": "plugin",
  "plugin_type": "theme",
  "permissions": ["ThemeInstall"],
  "theme": {
    "id": "sidebar-dark",
    "name": "Sidebar Dark",
    "version": "1.1.0",
    "developer": "IORA",
    "description": "Minimales Dark-Theme mit CSS-getriebener Sidebar-Navigation – elegant und responsive",
    "icon": "Sidebar",
    "preview_image": "images/preview.svg",
    "parent_theme": "night",
    "source": "inline",
    "order": 55,

    "css_files": [],
    "js_files": [],

    "fonts": [
      {
        "name": "Inter",
        "family": "'Inter', 'SF Pro', sans-serif",
        "url": "https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500&display=swap",
        "weights": "300;400;500",
        "subsets": "latin",
        "is_primary": true,
        "is_heading": false,
        "is_monospace": false
      }
    ],

    "css_variables": {
      "layout-nav-position": "left",
      "layout-nav-width": "240px",
      "layout-header-style": "compact",
      "layout-card-radius": "1rem",
      "layout-widget-gap": "1rem",
      "background": "oklch(0.18 0.02 260)",
      "foreground": "oklch(0.85 0.015 260)",
      "card": "oklch(0.22 0.025 260)",
      "card-foreground": "oklch(0.88 0.015 260)",
      "accent": "oklch(0.62 0.20 260)",
      "accent-foreground": "oklch(0.98 0 0)",
      "muted": "oklch(0.25 0.02 260)",
      "muted-foreground": "oklch(0.55 0.02 260)",
      "border": "oklch(0.28 0.015 260)",
      "ring": "oklch(0.62 0.20 260)",
      "glass-bg": "oklch(0.22 0.03 260 / 0.55)",
      "glass-bg-end": "oklch(0.18 0.02 260 / 0.45)",
      "glass-border-color": "oklch(0.40 0.02 260 / 0.12)",
      "glass-shadow-1": "oklch(0 0 0 / 0.15)",
      "glass-shadow-2": "oklch(0 0 0 / 0.08)",
      "success": "oklch(0.55 0.16 145)",
      "destructive": "oklch(0.50 0.22 30)",
      "transition-duration": "0.4s"
    },

    "additional_css": "/* ─── Sidebar Theme: Additional Styling ─── */\n:root[data-nav-position=\"left\"] [data-nav=\"root\"] {\n  background: oklch(0.16 0.025 260 / 0.95) !important;\n  backdrop-filter: blur(30px) saturate(1.4);\n  border-right: 1px solid oklch(0.35 0.02 260 / 0.2);\n  box-shadow: 2px 0 30px oklch(0 0 0 / 0.3);\n}\n:root[data-nav-position=\"left\"] [data-nav=\"root\"] button { min-height: 48px !important; margin: 2px 4px !important; font-size: 14px !important; }\n:root[data-nav-position=\"left\"] [data-nav=\"root\"] button:hover { background: oklch(0.30 0.03 260 / 0.4) !important; }\n:root[data-nav-position=\"left\"] main { padding-top: 1.5rem !important; }\n:root[data-header-style=\"compact\"] .glass-header { background: oklch(0.20 0.02 260 / 0.6) !important; backdrop-filter: blur(20px); border-bottom: 1px solid oklch(0.30 0.02 260 / 0.15); }\n.glass-card { transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease; }\n.glass-card:hover { border-color: oklch(from var(--accent) l c h / 0.15); transform: translateY(-1px); }\n@media (max-width: 768px) {\n  :root[data-nav-position=\"left\"] { --layout-nav-width: 0px; }\n  :root[data-nav-position=\"left\"] [data-nav=\"root\"] {\n    bottom: 0 !important; top: auto !important; left: 50% !important; right: auto !important;\n    transform: translateX(-50%) !important; width: auto !important; max-width: calc(100vw - 1rem) !important;\n    flex-direction: row !important; border-radius: 9999px !important; border-right: none !important;\n  }\n  :root[data-nav-position=\"left\"] [data-nav=\"root\"] .flex.items-center { flex-direction: row !important; }\n  :root[data-nav-position=\"left\"] [data-nav=\"root\"] > div { flex-direction: row !important; height: auto !important; }\n  :root[data-nav-position=\"left\"] main, :root[data-nav-position=\"left\"] .page-content { padding-left: 1rem !important; }\n  :root[data-nav-position=\"left\"] .glass-header { padding-left: 0 !important; }\n}\n",

    "capabilities": {
      "design_modes": [
        {
          "id": "sidebar-light",
          "name": "Sidebar Hell",
          "icon": "Sun",
          "time_start": "06:00",
          "time_end": "18:00",
          "css_variables": {
            "background": "oklch(0.96 0.005 260)",
            "foreground": "oklch(0.20 0.02 260)",
            "card": "oklch(0.99 0.002 260)",
            "card-foreground": "oklch(0.16 0.02 260)",
            "accent": "oklch(0.55 0.22 260)",
            "muted": "oklch(0.93 0.005 260)",
            "muted-foreground": "oklch(0.50 0.02 260)",
            "border": "oklch(0.87 0.005 260)",
            "glass-bg": "oklch(0.97 0.003 260 / 0.55)",
            "glass-bg-end": "oklch(0.99 0.001 260 / 0.45)"
          }
        },
        {
          "id": "sidebar-dark",
          "name": "Sidebar Dunkel",
          "icon": "MoonStars",
          "time_start": "18:00",
          "time_end": "06:00",
          "css_variables": {
            "background": "oklch(0.18 0.02 260)",
            "foreground": "oklch(0.85 0.015 260)",
            "card": "oklch(0.22 0.025 260)",
            "card-foreground": "oklch(0.88 0.015 260)",
            "accent": "oklch(0.62 0.20 260)",
            "muted": "oklch(0.25 0.02 260)",
            "muted-foreground": "oklch(0.55 0.02 260)",
            "border": "oklch(0.28 0.015 260)",
            "glass-bg": "oklch(0.22 0.03 260 / 0.55)",
            "glass-bg-end": "oklch(0.18 0.02 260 / 0.45)"
          }
        }
      ],
      "auto_behavior": {
        "mode": "time",
        "time_ranges": {
          "sidebar-light": { "start": "06:00", "end": "18:00" },
          "sidebar-dark": { "start": "18:00", "end": "06:00" }
        },
        "default_mode": "sidebar-dark"
      },
      "accent_control": {
        "mode": "presets",
        "presets": [
          { "name": "Indigo (Standard)", "color": "oklch(0.62 0.20 260)" },
          { "name": "Violett", "color": "oklch(0.55 0.22 285)" },
          { "name": "Blau", "color": "oklch(0.60 0.22 240)" },
          { "name": "Grün", "color": "oklch(0.55 0.18 145)" }
        ]
      },
      "glass_control": {
        "mode": "force_on"
      },
      "custom_settings": [
        {
          "id": "sidebar_collapsed",
          "name": "Sidebar minimieren",
          "description": "Sidebar standardmäßig einklappen",
          "setting_type": "toggle",
          "default_value": false,
          "css_variable": "layout-nav-width"
        },
        {
          "id": "card_shadow_intensity",
          "name": "Kartenschatten",
          "description": "Intensität des Schattens unter Karten",
          "setting_type": "slider",
          "default_value": 50,
          "min": 0, "max": 100, "step": 10
        }
      ],
      "animation": {
        "splash": {
          "enabled": true,
          "duration_ms": 2000,
          "background_color": "oklch(0.18 0.02 260)",
          "brand_text": "Sidebar",
          "tagline": "Clean Navigation",
          "show_progress": true,
          "exit_animation": "slide-down"
        },
        "page_transitions": {
          "enabled": true,
          "transition_type": "fade",
          "duration_secs": 0.35,
          "spring": { "stiffness": 320, "damping": 28, "mass": 1.0 }
        },
        "widget_animations": {
          "style": "fade-up",
          "duration_secs": 0.4,
          "stagger_secs": 0.03
        }
      }
    }
  }
}
