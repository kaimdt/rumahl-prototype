{
  "id": "ora-notes",
  "name": "Notizen",
  "version": "1.0.0",
  "developer": "IORA Team",
  "description": "Einfache Notizen-App – jede Notiz wird über das ORA App Storage (KV) gespeichert. Zeigt, wie eine installierbare App das App-Framework nutzt.",
  "icon": "https://img.icons8.com/color/256/notebook.png",
  "type": "app",
  "permissions": [
    "AppStorageRead",
    "AppStorageWrite",
    "AppStorageDelete",
    "AppStorageManage"
  ],
  "storage": {
    "enabled": true,
    "quota": {
      "max_file_storage_bytes": 5242880,
      "max_kv_entries": 100,
      "max_file_size_bytes": 1048576
    }
  },
  "custom_pages": [
    {
      "id": "ora-notes-main",
      "title": "Notizen",
      "icon": "NotePencil",
      "url": "/apps/ora-notes/",
      "show_in_nav": true,
      "order": 210
    }
  ],
  "settings_schema": {
    "title": "Notizen Einstellungen",
    "description": "Einstellungen der Notizen-App",
    "fields": [
      {
        "key": "sort_newest_first",
        "label": "Neueste zuerst",
        "description": "Neueste Notizen oben anzeigen",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "docker": {
    "auto_build": true,
    "base_image": "node:18-alpine",
    "working_dir": "/app",
    "install_cmd": "npm install",
    "start_cmd": "node server.js",
    "internal_ports": [
      {
        "port": 3000,
        "protocol": "tcp",
        "description": "HTTP API und Web-UI"
      }
    ],
    "environment": {
      "NODE_ENV": "production"
    },
    "health_check": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10,
      "retries": 3
    }
  },
  "store_metadata": {
    "category": "Produktivität",
    "tags": ["notizen", "notes", "produktivität"],
    "screenshots": [],
    "min_iora_version": "2.0.0",
    "homepage": "https://github.com/kaimdt/ora",
    "source_url": "https://github.com/kaimdt/ora",
    "license": "MIT"
  }
}
