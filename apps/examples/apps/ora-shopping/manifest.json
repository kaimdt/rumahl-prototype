{
  "id": "ora-shopping",
  "name": "Einkaufsliste",
  "version": "1.0.0",
  "developer": "IORA Team",
  "description": "Gemeinsame Einkaufsliste – Artikel mit Menge und Erledigt-Häkchen, gespeichert über das ORA App Storage.",
  "icon": "https://img.icons8.com/color/256/shopping-cart.png",
  "type": "app",
  "permissions": [
    "AppStorageRead",
    "AppStorageWrite",
    "AppStorageDelete",
    "AppStorageManage"
  ],
  "storage": {
    "enabled": true,
    "quota": {
      "max_file_storage_bytes": 5242880,
      "max_kv_entries": 100,
      "max_file_size_bytes": 1048576
    }
  },
  "custom_pages": [
    {
      "id": "ora-shopping-main",
      "title": "Einkaufsliste",
      "icon": "ShoppingCart",
      "url": "/apps/ora-shopping/",
      "show_in_nav": true,
      "order": 211
    }
  ],
  "docker": {
    "auto_build": true,
    "base_image": "node:18-alpine",
    "working_dir": "/app",
    "install_cmd": "npm install",
    "start_cmd": "node server.js",
    "internal_ports": [
      {
        "port": 3000,
        "protocol": "tcp",
        "description": "HTTP API und Web-UI"
      }
    ],
    "environment": {
      "NODE_ENV": "production"
    },
    "health_check": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10,
      "retries": 3
    }
  },
  "store_metadata": {
    "category": "Haushalt",
    "tags": [
      "einkauf",
      "liste",
      "haushalt"
    ],
    "min_iora_version": "2.0.0",
    "license": "MIT"
  }
}