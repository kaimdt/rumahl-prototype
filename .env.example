# Backend API URL (optional, defaults to http://localhost:3001)
VITE_BACKEND_URL=http://localhost:3001

# IORA Docker Environment Configuration

# PostgreSQL Configuration
POSTGRES_USER=iora
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=iora_home
POSTGRES_PORT=5432

# Service Ports
HOME_PORT=8080
CORE_PORT=8090
CONTROL_PORT=8091
ASSIST_PORT=8092
SECRETS_PORT=8093
WATCHDOG_PORT=8094
SECURITY_PORT=8095
GATEWAY_PORT=8096
SUPERVISOR_PORT=8097

# Home Assistant Configuration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_access_token

# Security Keys (generate with: openssl rand -hex 32)
JWT_SECRET=generate_a_secure_random_jwt_secret_key_here
SECRETS_MASTER_KEY=generate_a_64_character_hex_string_for_secrets_encryption
SECURITY_DB_KEY=generate_a_64_character_hex_string_for_security_db_encryption

# AI Configuration (optional)
ASSIST_AI_BACKEND_URL=http://localhost:1234/v1
ASSIST_AI_API_KEY=

# SMTP Configuration (for gateway email)
SMTP_SERVER=smtp.gmail.com:587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Logging
RUST_LOG=info
