# Home Assistant URL (required)
HA_URL=http://homeassistant.local:8123

# Home Assistant Long-Lived Access Token (required)
# Get this from your Home Assistant Profile > Security > Long-Lived Access Tokens
HA_TOKEN=your_long_lived_access_token_here

# Database URL (PostgreSQL required)
DATABASE_URL=postgres://iora:iora_password@localhost:5432/iora_home

# Server Port (optional, defaults to 3001)
PORT=3001

# Log Level (optional, defaults to info)
# Options: trace, debug, info, warn, error
RUST_LOG=info

# CORS Origins (optional, defaults to allow all)
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:5000,https://yourdomain.com
