{
  "id": "io.iora.developer-app",
  "name": "IORA Developer",
  "version": "0.1.0",
  "developer": "IORA Team",
  "description": "Official IORA development tool for IDE integration, hot reload, and app development workflows",
  "icon": "/static/icon.png",
  "type": "app",
  "permissions": [
    "DeveloperAccess",
    "InterAppCommunication",
    "LiveMetrics",
    "DirectDeploy",
    "DebugAccess",
    "LiveLogs",
    "HotReload"
  ],
  "endpoints": [
    {
      "path": "/health",
      "method": "GET",
      "description": "Health check endpoint",
      "requires_auth": false,
      "public": true
    },
    {
      "path": "/api/info",
      "method": "GET",
      "description": "Get app information and capabilities",
      "requires_auth": false,
      "public": true
    },
    {
      "path": "/api/public/developer-status",
      "method": "GET",
      "description": "Get Developer Mode status (public endpoint for other apps)",
      "requires_auth": false,
      "public": true
    },
    {
      "path": "/api/public/deployment-info/:app_id",
      "method": "GET",
      "description": "Get app deployment information (for other apps in Developer Mode)",
      "requires_auth": false,
      "public": true,
      "developer_mode_required": true
    },
    {
      "path": "/api/public/app-metrics/:app_id",
      "method": "GET",
      "description": "Get app metrics (for other apps in Developer Mode)",
      "requires_auth": false,
      "public": true,
      "developer_mode_required": true
    },
    {
      "path": "/api/hotreload/upload",
      "method": "POST",
      "description": "Upload app package for hot reload",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/api/hotreload/status/:deployment_id",
      "method": "GET",
      "description": "Get hot reload status",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/api/hotreload/rollback/:app_id",
      "method": "POST",
      "description": "Rollback to previous version",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/api/hotreload/history/:app_id",
      "method": "GET",
      "description": "Get hot reload history",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/api/ide/deploy",
      "method": "POST",
      "description": "Deploy from IDE",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/api/ide/logs/:app_id/stream",
      "method": "GET",
      "description": "Stream live logs from app",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/api/ide/metrics",
      "method": "GET",
      "description": "Get system metrics",
      "requires_auth": true,
      "exclusive": true
    },
    {
      "path": "/swagger-ui",
      "method": "GET",
      "description": "Dynamic Swagger API documentation",
      "requires_auth": false,
      "public": true
    }
  ],
  "docker": {
    "auto_build": false,
    "image": "iora-developer-app:local",
    "internal_ports": [
      {
        "port": 8099,
        "protocol": "tcp",
        "assignment_mode": "fixed",
        "description": "Developer App HTTP API"
      }
    ],
    "environment": {
      "RUST_LOG": "info",
      "SUPERVISOR_URL": "http://iora-supervisor:8097",
      "IORA_API_URL": "http://iora-api:8080",
      "IORA_DEVELOPER_APP_TOKEN": "${IORA_DEVELOPER_APP_TOKEN}"
    },
    "volumes": [
      "/var/run/docker.sock:/var/run/docker.sock:ro",
      "iora-developer-data:/app/data"
    ],
    "health_check": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10,
      "retries": 3
    }
  },
  "developer_mode": {
    "allowed": true,
    "allow_in_production": false
  },
  "installation_source": "developer_app",
  "security": {
    "token_required": true,
    "token_env_var": "IORA_DEVELOPER_APP_TOKEN",
    "description": "This app requires a unique security token generated at build time to ensure only the official Developer App can access exclusive features"
  },
  "store_metadata": {
    "category": "developer-tools",
    "tags": ["development", "ide", "hot-reload", "debugging", "swagger", "api-docs"],
    "license": "MIT",
    "features": [
      "Hot reload with version history",
      "IDE integration",
      "Live log streaming",
      "Real-time metrics",
      "Public APIs for other apps",
      "Dynamic Swagger documentation"
    ]
  }
}
