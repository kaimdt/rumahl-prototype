{
  "name": "ORA Home",
  "short_name": "ORA Home",
  "description": "Native smart home system app for ORA OS",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080b10",
  "theme_color": "#0f172a",
  "categories": ["lifestyle", "utilities", "productivity"],
  "icons": [
    {
      "src": "/iora-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "ORA OS Homescreen",
      "short_name": "ORA OS",
      "url": "/"
    },
    {
      "name": "ORA Home",
      "short_name": "Home",
      "url": "/home"
    }
  ]
}
