# Demo overrides – loaded by `npm run dev:demo` (Vite --mode demo)
# Runs the frontend entirely without a real backend. The mock middleware
# (mock/demoServer.mjs) answers /api/*, /health and /ws, and the app auto-logs
# into a demo admin session. Do not use for production.
VITE_DEMO=1
VITE_BACKEND_URL=
VITE_rumahl_ASSIST_URL=
