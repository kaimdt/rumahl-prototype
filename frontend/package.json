{
    "name": "iora-dashboard",
    "private": true,
    "version": "2.0.0",
    "description": "IORA — Interface for Optimized Residential Autonomy — a modern smart home ecosystem with real-time entity control, weather forecasts, history, drag-and-drop page design, and multi-user support.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:full": "node ../scripts/dev/start-full.mjs",
        "dev:all": "node ../scripts/dev/iora-dev.mjs",
        "dev:start": "node ../scripts/dev/iora-dev.mjs start all",
        "dev:watch": "node ../scripts/dev/iora-dev.mjs start all --watch",
        "dev:list": "node ../scripts/dev/iora-dev.mjs list",
        "build": "tsc -b --noCheck && vite build",
        "lint": "eslint .",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "test": "bun test --preload ./src/test/setup.ts"
    },
