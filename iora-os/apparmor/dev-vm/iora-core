#include <tunables/global>
#include <tunables/proc>
# IORA OS dev VM starter profile for iora-core (service registry; native,
# NOT the Docker container profile - see apparmor/iora-core for that one).
# Loaded in COMPLAIN mode by the dev VM provisioning (violations are logged,
# nothing is blocked). Attaches by process name - covers /usr/bin/iora-core
# (build mode) and the cargo-run binary (source mode).
#
# Flip to enforce:
#   sed -i 's/flags=(complain)//' /etc/apparmor.d/iora-core
#   apparmor_parser -r /etc/apparmor.d/iora-core
#   systemctl restart iora-core
profile iora-core flags=(complain) {
  #include <abstractions/base>
  #include <abstractions/openssl>

  capability net_bind_service,

  network inet stream,
  network inet6 stream,

  /etc/iora/** r,
  /opt/iora/data/iora-core/** rw,
  /var/log/iora/** w,
  /usr/bin/iora-core mr,
  /usr/lib/iora/** mr,
  /home/iora/iora/iora-os/backend/target/** mr,
  /dev/urandom r,
  /proc/** r,
}
