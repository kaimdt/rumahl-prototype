#include <tunables/global>
#include <tunables/proc>
# IORA OS dev VM starter profile for iora-watchdog (health monitoring;
# native, NOT the Docker container profile - see apparmor/iora-watchdog).
# Loaded in COMPLAIN mode by the dev VM provisioning (violations are logged,
# nothing is blocked). Attaches by process name - covers
# /usr/bin/iora-watchdog (build mode) and the cargo-run binary (source mode).
#
# Flip to enforce:
#   sed -i 's/flags=(complain)//' /etc/apparmor.d/iora-watchdog
#   apparmor_parser -r /etc/apparmor.d/iora-watchdog
#   systemctl restart iora-watchdog
profile iora-watchdog flags=(complain) {
  #include <abstractions/base>

  network inet stream,
  network inet6 stream,

  /etc/iora/** r,
  /var/log/iora/** w,
  /opt/iora/data/iora-watchdog/** rw,
  /usr/bin/iora-watchdog mr,
  /usr/lib/iora/** mr,
  /home/iora/iora/iora-os/backend/target/** mr,
  /run/systemd/** r,
  /proc/** r,
  /dev/urandom r,
}
