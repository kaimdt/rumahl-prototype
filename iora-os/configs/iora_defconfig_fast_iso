# Buildroot Configuration for IORA OS – FAST BOOT ISO
# Minimal rootfs: only what's needed to boot and run the IORA installer.
# Skips Docker Engine, Python, TPM, RAUC, plymouth, vim, tmux, screen,
# dialog, fbv, smartmontools, AppArmor — saving ~40% compile time.

# ── Build acceleration ───────────────────────────────────────────────
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.iora-cache/ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=10G"
BR2_DL_DIR="$(HOME)/.iora-cache/dl"
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_IORA_PATH)/board/iora/patches"

# Target Architecture
BR2_x86_64=y
BR2_X86_64_CORE2=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_IORA_PATH)/board/iora/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_LZ4=y

# Bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y

# System
BR2_TARGET_GENERIC_HOSTNAME="iora"
BR2_TARGET_GENERIC_ISSUE="Welcome to IORA OS"
BR2_TARGET_GENERIC_ROOT_PASSWD="iora"
BR2_SYSTEM_DHCP="eth0"

# Init system
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Filesystem
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# Core packages (minimal)
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BASH=y

# Network tools (essential for installer)
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_WGET=y

# Compression utilities
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_LZ4=y
BR2_PACKAGE_XZ=y

# File systems
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_SQUASHFS=y
BR2_PACKAGE_DOSFSTOOLS=y

# System utilities (minimal)
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LESS=y

# Hardware support
BR2_PACKAGE_PCI_UTILS=y
BR2_PACKAGE_USB_UTILS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_UTIL_LINUX_CFDISK=y
BR2_PACKAGE_UTIL_LINUX_FDISK=y
BR2_PACKAGE_EFIBOOTMGR=y

# Time synchronization
BR2_PACKAGE_CHRONY=y

# Disk image
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="4G"

# Post-build scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IORA_PATH)/board/iora/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IORA_PATH)/board/iora/post-image.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IORA_PATH)/board/iora/rootfs-overlay"

# External tree
BR2_EXTERNAL_IORA_PATH="$(BR2_EXTERNAL)"
