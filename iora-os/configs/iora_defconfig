# Buildroot Configuration for IORA OS
# Custom Linux OS for IORA Smart Home System

# Target Architecture
BR2_x86_64=y
BR2_X86_64_CORE2=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_IORA_PATH)/board/iora/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Compression
BR2_LINUX_KERNEL_LZ4=y

# Bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y

# System
BR2_TARGET_GENERIC_HOSTNAME="iora"
BR2_TARGET_GENERIC_ISSUE="Welcome to IORA OS"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD="iora"
BR2_SYSTEM_DHCP="eth0"

# Init system
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Filesystem
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y

# Required packages
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BASH_COMPLETION=y

# Docker support
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_COMPOSE=y
BR2_PACKAGE_CONTAINERD=y

# Network tools
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_WGET=y

# Compression utilities
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_LZ4=y
BR2_PACKAGE_XZ=y

# File systems
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_SQUASHFS=y
BR2_PACKAGE_ZRAM_TOOLS=y

# System utilities
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_SCREEN=y

# Hardware support
BR2_PACKAGE_PCI_UTILS=y
BR2_PACKAGE_USB_UTILS=y

# Python (for utilities)
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PIP=y

# RAUC update system
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_SERVICE=y
BR2_PACKAGE_RAUC_NETWORK=y

# AppArmor security
BR2_PACKAGE_APPARMOR=y
BR2_PACKAGE_APPARMOR_UTILS=y

# PostgreSQL client libraries
BR2_PACKAGE_POSTGRESQL=y

# Time synchronization
BR2_PACKAGE_CHRONY=y

# Disk image
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="8G"

# Post-build scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IORA_PATH)/board/iora/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IORA_PATH)/board/iora/post-image.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IORA_PATH)/board/iora/rootfs-overlay"

# External tree
BR2_EXTERNAL_IORA_PATH="$(BR2_EXTERNAL)/iora"
