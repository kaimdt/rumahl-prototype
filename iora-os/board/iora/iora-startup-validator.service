[Unit]
Description=IORA OS Startup Validator
Documentation=https://github.com/your-org/iora
# iora-supervisor is a docker container, NOT a systemd unit — referring
# to it with After= produced a dangling dependency warning in journalctl.
# We only need docker + network to be ordered before us; the validator
# itself is informational and never fails (script always exits 0).
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/iora-startup-validator
RemainAfterExit=yes
# Mirror log to boot console so the user sees "iora-validator: …" lines.
StandardOutput=journal+console
StandardError=journal+console
# Hard upper bound — script itself aborts after 30 s, systemd kills at 60 s.
TimeoutStartSec=60
# The validator is purely informational; never let it fail the boot.
SuccessExitStatus=0 1
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
