From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IORA Build System <build@iora.local>
Date: Sat, 3 May 2026 00:00:00 +0000
Subject: [PATCH] Fix GCC 15/C23 incompatible function pointer casts

GCC 15 defaults to -std=gnu23 where empty parameter lists mean (void)
instead of unspecified parameters.  The casts from read() to
ssize_t(*)() are now incompatible because the empty parens no longer
match int(*)(int,void*,size_t).  Add explicit parameter types to the
casts.

Based on the upstream fix by Arnold Robbins for gawk 5.3.0:
https://lists.gnu.org/archive/html/bug-gawk/2024-08/msg00020.html

--- a/io.c
+++ b/io.c
@@ -3388,7 +3388,7 @@ iop_alloc(int fd, const char *name, int errno_val)
 
 	iop->public.fd = fd;
 	iop->public.name = name;
-	iop->public.read_func = ( ssize_t(*)() ) read;
+	iop->public.read_func = ( ssize_t(*)(int, void *, size_t) ) read;
 	iop->valid = false;
 	iop->errcode = errno_val;
 
@@ -4448,7 +4448,7 @@ get_read_timeout(IOBUF *iop)
 	}
 
 	/* overwrite read routine only if an extension has not done so */
-	if ((iop->public.read_func == ( ssize_t(*)() ) read) && tmout > 0)
+	if ((iop->public.read_func == ( ssize_t(*)(int, void *, size_t) ) read) && tmout > 0)
 		iop->public.read_func = read_with_timeout;
 
 	return tmout;
--- a/awkgram.y
+++ b/awkgram.y
@@ -3105,11 +3105,6 @@ get_src_buf()
 	int savelen;
 	struct stat sbuf;
 
-	/*
-	 * No argument prototype on readfunc on purpose,
-	 * avoids problems with some ancient systems where
-	 * the types of arguments to read() aren't up to date.
-	 */
 	static ssize_t (*readfunc)(int, void *, size_t) = NULL;
 
 	if (readfunc == NULL) {
