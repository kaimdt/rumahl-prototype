From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IORA Build System <build@iora.local>
Date: Sat, 3 May 2026 00:00:00 +0000
Subject: [PATCH] Fix _GL_ATTRIBUTE_NODISCARD with GCC 15+ in C23 mode

GCC 15 defaults to -std=gnu23 where [[nodiscard]] between
storage-class/inline specifier and return type is a syntax error.

Remove _GL_ATTRIBUTE_NODISCARD from all inline function definitions
in gl_oset.h and gl_list.h (keeping it only on declarations where it
is syntactically valid).  Line numbers corrected for m4-1.4.19.

--- a/lib/gl_oset.h
+++ b/lib/gl_oset.h
@@ -275,7 +275,7 @@
          ->search_atleast (set, threshold_fn, threshold, eltp);
 }
 
-GL_OSET_INLINE _GL_ATTRIBUTE_NODISCARD int
+GL_OSET_INLINE int
 gl_oset_nx_add (gl_oset_t set, const void *elt)
 {
   return ((const struct gl_oset_impl_base *) set)->vtable->nx_add (set, elt);
--- a/lib/gl_list.h
+++ b/lib/gl_list.h
@@ -633,7 +633,7 @@
          ->node_value (list, node);
 }
 
-GL_LIST_INLINE _GL_ATTRIBUTE_NODISCARD int
+GL_LIST_INLINE int
 gl_list_node_nx_set_value (gl_list_t list, gl_list_node_t node,
                            const void *elt)
 {
@@ -688,20 +688,20 @@
   return gl_list_get_at (list, gl_list_size (list) - 1);
 }
 
-GL_LIST_INLINE _GL_ATTRIBUTE_NODISCARD gl_list_node_t
+GL_LIST_INLINE gl_list_node_t
 gl_list_nx_set_at (gl_list_t list, size_t position, const void *elt)
 {
   return ((const struct gl_list_impl_base *) list)->vtable
          ->nx_set_at (list, position, elt);
 }
 
-GL_LIST_INLINE _GL_ATTRIBUTE_NODISCARD gl_list_node_t
+GL_LIST_INLINE gl_list_node_t
 gl_list_nx_set_first (gl_list_t list, const void *elt)
 {
   return gl_list_nx_set_at (list, 0, elt);
 }
 
-GL_LIST_INLINE _GL_ATTRIBUTE_NODISCARD gl_list_node_t
+GL_LIST_INLINE gl_list_node_t
 gl_list_nx_set_last (gl_list_t list, const void *elt)
 {
   return gl_list_nx_set_at (list, gl_list_size (list) - 1, elt);
@@ -755,29 +755,29 @@
          ->indexof_from_to (list, start_index, end_index, elt);
 }
 
-GL_LIST_INLINE _GL_ATTRIBUTE_NODISCARD gl_list_node_t
+GL_LIST_INLINE gl_list_node_t
