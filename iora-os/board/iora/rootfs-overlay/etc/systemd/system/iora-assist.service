[Unit]
Description=IORA Assist – AI & Agent Service
After=network.target iora-home.service
Wants=network.target iora-home.service

[Service]
Type=simple
ExecStart=/opt/iora/bin/iora-assist
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iora-assist
Environment=RUST_LOG=iora_assist=info
WorkingDirectory=/opt/iora

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/iora/data /opt/iora/docs /tmp/iora-sandboxes
ReadOnlyPaths=/opt/iora/bin

[Install]
WantedBy=multi-user.target
