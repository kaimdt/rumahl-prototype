// IORA OS Plymouth Boot Splash — script theme
// Compatible with Plymouth 22.x (Buildroot 2024.02).
//
// Bug fixes vs original:
//   - Removed invalid Image.CreateFromJPEG(null) call (crashed script engine)
//   - Removed String.CharAt() which does not exist in Plymouth script
//   - Fixed text API: Image.Text(string, r, g, b) instead of Text.SetFont(...)
//   - Spinner now uses pre-rendered image array instead of string indexing
//   - Progress bar pixel loop cleaned up

// ── Background ───────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor(0.05, 0.05, 0.10);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.06);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

// ── Logo (PNG preferred, text fallback) ──────────────────────────────────────
// logo.png ships in this theme directory (480x112, transparent bg:
// brand mark + wordmark). Replace it to rebrand; if the file is absent
// the theme falls back to a plain text label.
logo_sprite = Sprite();
logo_image  = Image("logo.png");
if (logo_image) {
    logo_sprite.SetImage(logo_image);
    logo_sprite.SetX(screen_width  / 2 - logo_image.GetWidth()  / 2);
    // Bottom-anchored so the wordmark clears the tagline below it.
    logo_sprite.SetY(screen_height / 2 - logo_image.GetHeight() - 48);
    logo_sprite.SetOpacity(1);
} else {
    // Image.Text(string, r, g, b) — Plymouth 22.x script API
    title_img = Image.Text("IORA OS", 1.0, 1.0, 1.0);
    logo_sprite.SetImage(title_img);
    logo_sprite.SetX(screen_width / 2 - title_img.GetWidth() / 2);
    logo_sprite.SetY(screen_height / 2 - 90);
}

// ── Tagline label ─────────────────────────────────────────────────────────────
tagline_img    = Image.Text("Your Home. Your Control.", 0.50, 0.62, 0.88);
tagline_sprite = Sprite(tagline_img);
tagline_sprite.SetX(screen_width / 2 - tagline_img.GetWidth() / 2);
tagline_sprite.SetY(screen_height / 2 - 35);

// ── Progress bar ──────────────────────────────────────────────────────────────
// Track: static dim background.  Fill: updated on boot progress events.
bar_total_w = Math.Min(420, screen_width - 80);
bar_h       = 3;
bar_x       = (screen_width  - bar_total_w) / 2;
bar_y       = screen_height / 2 + 50;

// Background track (drawn once at startup)
track_img = Image(bar_total_w, bar_h);
for (tx = 0; tx < bar_total_w; tx++)
    for (ty = 0; ty < bar_h; ty++)
        track_img.SetPixel(tx, ty, 0.14, 0.17, 0.28, 1.0);
track_sprite = Sprite(track_img);
track_sprite.SetX(bar_x);
track_sprite.SetY(bar_y);

// Fill sprite — re-created on each progress callback
fill_sprite = Sprite();
fill_sprite.SetX(bar_x);
fill_sprite.SetY(bar_y);

fun progress_callback(time, progress_val) {
    fw = Math.Max(1, Math.Int(bar_total_w * progress_val));
    fill_img = Image(fw, bar_h);
    for (fx = 0; fx < fw; fx++)
        for (fy = 0; fy < bar_h; fy++)
            fill_img.SetPixel(fx, fy, 0.28, 0.55, 1.0, 1.0);
    fill_sprite.SetImage(fill_img);
}

Plymouth.SetBootProgressFunction(progress_callback);

// ── Spinner animation ─────────────────────────────────────────────────────────
// Pre-render four frames into an indexed array.
// String.CharAt() does NOT exist in Plymouth script — use an image array.
spin_imgs    = [];
spin_imgs[0] = Image.Text("|",  0.38, 0.48, 0.76);
spin_imgs[1] = Image.Text("/",  0.38, 0.48, 0.76);
spin_imgs[2] = Image.Text("-",  0.38, 0.48, 0.76);
spin_imgs[3] = Image.Text("\\", 0.38, 0.48, 0.76);

spin_idx    = 0;
spin_sprite = Sprite(spin_imgs[0]);
spin_sprite.SetX(screen_width / 2 - 4);
spin_sprite.SetY(bar_y + 12);

fun refresh_callback() {
    spin_idx = (spin_idx + 1) % 4;
    spin_sprite.SetImage(spin_imgs[spin_idx]);
}

Plymouth.SetRefreshFunction(refresh_callback);

// ── Status / boot messages ────────────────────────────────────────────────────
msg_sprite = Sprite();
msg_sprite.SetX(8);
msg_sprite.SetY(screen_height - 26);

fun display_message_callback(text) {
    msg_img = Image.Text(text, 0.38, 0.42, 0.60);
    msg_sprite.SetImage(msg_img);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);

// ── Password / normal mode handling ──────────────────────────────────────────
fun display_normal_callback() {
    // Nothing extra needed in normal boot mode.
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
