      ],
      "docker": {
        "auto_build": true,
        "base_image": "rust:1.75-slim",
        "environment": {
          "RUST_LOG": "info"
        },
        "health_check": {
          "endpoint": "/health",
          "interval": 30,
          "retries": 3,
          "timeout": 10
        },
        "install_cmd": "cargo build --release",
        "internal_ports": [
          {
            "assignment_mode": "random",
