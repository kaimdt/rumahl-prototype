      "name": "Network Scanner",
      "version": "1.0.0",
      "developer": "IORA Team",
      "description": "Scan and discover devices on your local network",
      "icon": "icon.png",
      "type": "app",
      "permissions": [
        "NetworkLocalAccess",
        "NetworkScan",
        "ReadEntities",
        "StorageWrite",
        "StorageRead",
        "SendNotifications",
        "RegisterWidget"
      ],
      "custom_pages": [
