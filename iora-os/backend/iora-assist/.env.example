# ORA AI (IORA Assist) Configuration
# ============================================

# Service Port
PORT=8092

# AI Provider Selection
# Options: openai, anthropic, local, desktop
ORA_AI_PROVIDER=local

# Provider-Specific Configuration
# ---------------------------------

# OpenAI Configuration (when ORA_AI_PROVIDER=openai)
# ORA_AI_API_KEY=sk-your-openai-api-key-here
# ORA_AI_BASE_URL=https://api.openai.com/v1
# ORA_AI_MODEL=gpt-4o-mini

# Anthropic Configuration (when ORA_AI_PROVIDER=anthropic)
# ORA_AI_API_KEY=sk-ant-your-anthropic-api-key-here
# ORA_AI_BASE_URL=https://api.anthropic.com/v1
# ORA_AI_MODEL=claude-3-5-sonnet-20241022
# ORA_AI_API_VERSION=2023-06-01

# Local AI Configuration (when ORA_AI_PROVIDER=local)
# Examples: Ollama, LM Studio, LocalAI
ORA_AI_BASE_URL=http://localhost:11434
ORA_AI_MODEL=llama3.2

# Desktop AI Configuration (when ORA_AI_PROVIDER=desktop)
# Points to IORA Desktop proxy (LM Studio via desktop client)
# ORA_AI_BASE_URL=http://localhost:11435
# ORA_AI_MODEL=local-model

# Logging
RUST_LOG=iora_assist=debug,info

# Notes:
# - ORA_AI_PROVIDER determines which AI backend to use
# - For OpenAI and Anthropic, you MUST set ORA_AI_API_KEY
# - For Local and Desktop, API key is optional
# - BASE_URL can be customized for self-hosted or compatible APIs
# - MODEL can be changed to any supported model for the provider
