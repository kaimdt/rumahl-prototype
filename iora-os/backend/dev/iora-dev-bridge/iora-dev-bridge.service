# iora-dev-bridge.service — IORA OS Dev hot-reload bridge
#
# ⚠️  DEV IMAGES ONLY — never shipped on production.
# ⚠️  Runs as ROOT: needs full filesystem access, systemctl, docker.
# ⚠️  Binds to 0.0.0.0:8099 — reachable from developer workstation.
#
# The bridge authenticates via:
#   1. IORA dashboard credentials (POST /dev/auth → iora-home login)
#   2. Static token file at /var/lib/iora/dev-token (legacy fallback)
#
# Install:
#   sudo cp iora-dev-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now iora-dev-bridge
#
[Unit]
Description=IORA OS Dev Bridge (hot-reload endpoint)
Documentation=https://iora.os/docs/development
After=network-online.target iora-home.service docker.service
Wants=network-online.target iora-home.service

[Service]
Type=simple
# ⚠️  MUST run as root for binary replacement and systemctl access
User=root
Group=root
ExecStart=/usr/bin/iora-dev-bridge --listen 0.0.0.0:8099
Restart=always
RestartSec=5
# Environment overrides:
#   IORA_DEV_BIND=127.0.0.1:8099        (bind to localhost only)
#   IORA_DEV_TOKEN_FILE=/custom/path    (static token file location)
Environment=RUST_LOG=info
# Give iora-home time to start before we try credential auth
ExecStartPre=/bin/sleep 2
# Allow binding to port even if lingering from previous crash
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
