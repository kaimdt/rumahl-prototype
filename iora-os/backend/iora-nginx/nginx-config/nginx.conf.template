# IORA NGINX Configuration Template
# This configuration is dynamically generated by iora-nginx service

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # Performance
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss
               application/rss+xml font/truetype font/opentype
               application/vnd.ms-fontobject image/svg+xml;

    # Rate limiting zones
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=general_limit:10m rate=50r/s;

    # Upstream for IORA services
    upstream iora_home {
        server 127.0.0.1:8080;
        keepalive 32;
    }

    upstream iora_core {
        server 127.0.0.1:8090;
        keepalive 32;
    }

    upstream iora_control {
        server 127.0.0.1:8091;
        keepalive 32;
    }

    upstream iora_assist {
        server 127.0.0.1:8092;
        keepalive 32;
    }

    upstream iora_secrets {
        server 127.0.0.1:8093;
        keepalive 32;
    }

    upstream iora_watchdog {
        server 127.0.0.1:8094;
        keepalive 32;
    }

    upstream iora_security {
        server 127.0.0.1:8095;
        keepalive 32;
    }

    upstream iora_gateway {
        server 127.0.0.1:8096;
        keepalive 32;
    }

    upstream iora_supervisor {
        server 127.0.0.1:8097;
        keepalive 32;
    }

    upstream iora_appstore {
        server 127.0.0.1:8098;
        keepalive 32;
    }

    upstream iora_network_monitor {
        server 127.0.0.1:8099;
        keepalive 32;
    }

    upstream iora_domain_validator {
        server 127.0.0.1:8100;
        keepalive 32;
    }

    upstream iora_resource_manager {
        server 127.0.0.1:8101;
        keepalive 32;
    }

    # Dynamic app upstreams (generated by iora-nginx)
    {% for app in apps %}
    upstream app_{{ app.id | replace(from="-", to="_") }} {
        server 127.0.0.1:{{ app.port }};
        keepalive 8;
    }
    {% endfor %}

    # Main server block (HTTP)
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        # Redirect to HTTPS (can be disabled for local development)
        # return 301 https://$host$request_uri;

        # Root location - IORA Home
        location / {
            limit_req zone=general_limit burst=20 nodelay;
            proxy_pass http://iora_home;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # IORA Core API
        location /api/core/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_core/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Control Center
        location /api/control/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_control/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Assistant
        # NOTE: proxy_pass without trailing slash preserves the full
        # /api/assist/* URI because iora-assist mounts its routes at
        # `/api/assist/...` directly (not stripped). Stripping the prefix
        # here would 404 every assist endpoint.
        location /api/assist/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://iora_assist;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # IORA Secrets
        location /api/secrets/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://iora_secrets/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Watchdog
        location /api/watchdog/ {
            limit_req zone=api_limit burst=5 nodelay;
            proxy_pass http://iora_watchdog/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Security
        location /api/security/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_security/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Gateway
        location /api/gateway/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_gateway/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Supervisor
        location /api/supervisor/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_supervisor/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA App Store
        location /api/appstore/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_appstore/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Network Monitor
        location /api/network/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_network_monitor/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Domain Validator
        location /api/domain-validator/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://iora_domain_validator/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # IORA Resource Manager
        location /api/resources/ {
            limit_req zone=api_limit burst=10 nodelay;
            proxy_pass http://iora_resource_manager/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Dynamic app routes (generated by iora-nginx)
        {% for app in apps %}
        location /apps/{{ app.id }}/ {
            limit_req zone=general_limit burst=20 nodelay;
            proxy_pass http://app_{{ app.id | replace(from="-", to="_") }}/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-App-ID {{ app.id }};
            proxy_cache_bypass $http_upgrade;
        }
        {% endfor %}

        # Health check endpoint
        location /nginx-health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }

    # HTTPS server block (optional, for production)
    # server {
    #     listen 443 ssl http2 default_server;
    #     listen [::]:443 ssl http2 default_server;
    #     server_name _;
    #
    #     ssl_certificate /etc/nginx/ssl/cert.pem;
    #     ssl_certificate_key /etc/nginx/ssl/key.pem;
    #     ssl_protocols TLSv1.2 TLSv1.3;
    #     ssl_ciphers HIGH:!aNULL:!MD5;
    #     ssl_prefer_server_ciphers on;
    #
    #     # Same locations as HTTP server block
    # }
}
