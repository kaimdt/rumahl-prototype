{
  "name": "iora-dev",
  "displayName": "IORA OS Dev",
  "description": "Discover IORA OS Dev devices on your LAN, hot-deploy components, watch crates, monitor live service heartbeats and stream device logs from VS Code — backed by the iora-dev-deploy daemon.",
  "version": "0.4.0",
  "publisher": "iora",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/iora-os/iora-os"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["iora", "embedded", "smart-home", "deploy", "rust"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "IORA OS Dev",
      "properties": {
        "ioraDev.cliPath": {
          "type": "string",
          "default": "iora-dev-deploy",
          "description": "Path to the iora-dev-deploy binary."
        },
        "ioraDev.daemon.url": {
          "type": "string",
          "default": "",
          "description": "Override daemon URL (e.g. http://127.0.0.1:8765). Empty = read from ~/.config/iora-dev-deploy/daemon.json or auto-spawn."
        },
        "ioraDev.daemon.token": {
          "type": "string",
          "default": "",
          "description": "Override daemon bearer token. Empty = read from daemon.json."
        },
        "ioraDev.daemon.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the iora-dev-deploy daemon if it is not already running."
        },
        "ioraDev.daemon.bind": {
          "type": "string",
          "default": "127.0.0.1:8765",
          "description": "Bind address used when auto-starting the daemon."
        },
        "ioraDev.target": {
          "type": "string",
          "default": "aarch64-unknown-linux-gnu",
          "description": "Cross-compile target triple used for builds."
        },
        "ioraDev.buildMode": {
          "type": "string",
          "enum": ["auto", "device", "host", "cargo", "docker"],
          "enumDescriptions": [
            "Auto-detect: native cargo if the host can cross-compile, else docker, else build on the device. Recommended.",
            "Always upload the workspace and build incrementally on the IORA device. Slowest first build, fastest subsequent builds, works on any host (Windows-friendly).",
            "Always build locally on the developer machine (cargo or docker, whichever works).",
            "Force the native cargo path (will fail on Windows for ARM Linux targets).",
            "Force the docker cross-compile path. Requires Docker Desktop / Engine on the developer machine."
          ],
          "default": "auto",
          "description": "Build mode for deploy and watch. Defaults to `auto` so Windows hosts hot-reload via the on-device incremental build instead of failing on the cross-linker."
        },
        "ioraDev.discoverTimeoutSecs": {
          "type": "number",
          "default": 4,
          "description": "Seconds to listen for mDNS responses on Discover."
        },
        "ioraDev.watchDebounceMs": {
          "type": "number",
          "default": 800,
          "description": "Debounce window for file-watch sessions."
        },
        "ioraDev.automaticMode": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, Watch starts an automatic mode that scans all known IORA components and deploys whichever program changed."
        }
      }
    },
    "commands": [
      { "command": "ioraDev.discover",          "title": "IORA Dev: Discover Devices on LAN",    "icon": "$(broadcast)" },
      { "command": "ioraDev.connect",           "title": "IORA Dev: Connect to Device…",         "icon": "$(plug)" },
      { "command": "ioraDev.connectSaved",      "title": "IORA Dev: Reconnect to Saved Device",  "icon": "$(plug)" },
      { "command": "ioraDev.disconnect",        "title": "IORA Dev: Disconnect",                 "icon": "$(debug-disconnect)" },
      { "command": "ioraDev.forgetCredentials", "title": "IORA Dev: Forget Saved Credentials",   "icon": "$(trash)" },
      { "command": "ioraDev.deploy",            "title": "IORA Dev: Deploy Component(s)…",       "icon": "$(rocket)" },
      { "command": "ioraDev.deployCurrent",     "title": "IORA Dev: Deploy Current Crate",       "icon": "$(rocket)" },
      { "command": "ioraDev.watch",             "title": "IORA Dev: Watch Component(s)…",        "icon": "$(eye)" },
      { "command": "ioraDev.stopWatch",         "title": "IORA Dev: Stop Watch Session",         "icon": "$(stop-circle)" },
      { "command": "ioraDev.restart",           "title": "IORA Dev: Restart systemd Unit…" },
      { "command": "ioraDev.reload",            "title": "IORA Dev: Reload systemd Unit…" },
      { "command": "ioraDev.composeReload",     "title": "IORA Dev: Reload Compose Service…" },
      { "command": "ioraDev.logs",              "title": "IORA Dev: Tail Compose Logs…" },
      { "command": "ioraDev.logsFromTree",      "title": "IORA Dev: Show Service Logs",          "icon": "$(output)" },
      { "command": "ioraDev.componentActions",  "title": "IORA Dev: Component Actions…",         "icon": "$(ellipsis)" },
      { "command": "ioraDev.dashboard",         "title": "IORA Dev: Open Dashboard",             "icon": "$(dashboard)" },
      { "command": "ioraDev.startDaemon",       "title": "IORA Dev: Start Daemon" },
      { "command": "ioraDev.stopDaemon",        "title": "IORA Dev: Stop Daemon" },
      { "command": "ioraDev.refresh",           "title": "IORA Dev: Refresh Views",              "icon": "$(refresh)" },
      { "command": "ioraDev.showOutput",        "title": "IORA Dev: Show Output Channel" },
      { "command": "ioraDev.deployFromTree",    "title": "Deploy",                               "icon": "$(rocket)" },
      { "command": "ioraDev.watchFromTree",     "title": "Watch",                                "icon": "$(eye)" },
      { "command": "ioraDev.connectFromTree",   "title": "Connect",                              "icon": "$(plug)" },
      { "command": "ioraDev.stopWatchFromTree", "title": "Stop",                                 "icon": "$(stop-circle)" },
      { "command": "ioraDev.serviceLogs",       "title": "IORA Dev: Tail Service Logs…",         "icon": "$(output)" },
      { "command": "ioraDev.serviceLogsFromTree","title": "Logs",                                "icon": "$(output)" },
      { "command": "ioraDev.serviceRestartFromTree","title": "Restart",                          "icon": "$(debug-restart)" },
      { "command": "ioraDev.openServiceLiveLogs","title": "IORA Dev: Open Live Logs…",           "icon": "$(broadcast)" },
      { "command": "ioraDev.stopServiceLiveLogs","title": "IORA Dev: Stop Live Logs…" },
      { "command": "ioraDev.openServiceUrl",    "title": "IORA Dev: Open Service URL",           "icon": "$(link-external)" },
      { "command": "ioraDev.systemInfo",        "title": "IORA Dev: Show Device System Info",    "icon": "$(info)" },
      { "command": "ioraDev.rebootDevice",      "title": "IORA Dev: Reboot Device",              "icon": "$(refresh)" },
      { "command": "ioraDev.servicePalette",    "title": "IORA Dev: Service Actions…",           "icon": "$(list-selection)" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ioraDev",
          "title": "IORA OS Dev",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ioraDev": [
        { "id": "ioraDev.connection", "name": "Connection" },
        { "id": "ioraDev.devices",    "name": "Devices" },
        { "id": "ioraDev.services",   "name": "Services (live)" },
        { "id": "ioraDev.components", "name": "Components" },
        { "id": "ioraDev.activity",   "name": "Activity" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "ioraDev.connect",      "when": "view == ioraDev.connection", "group": "navigation@1" },
        { "command": "ioraDev.connectSaved", "when": "view == ioraDev.connection", "group": "navigation@2" },
        { "command": "ioraDev.dashboard",    "when": "view == ioraDev.connection", "group": "navigation@3" },
        { "command": "ioraDev.systemInfo",   "when": "view == ioraDev.connection", "group": "navigation@4" },
        { "command": "ioraDev.rebootDevice", "when": "view == ioraDev.connection", "group": "navigation@5" },
        { "command": "ioraDev.refresh",      "when": "view == ioraDev.connection", "group": "navigation@6" },
        { "command": "ioraDev.discover",     "when": "view == ioraDev.devices",    "group": "navigation@1" },
        { "command": "ioraDev.refresh",      "when": "view == ioraDev.devices",    "group": "navigation@2" },
        { "command": "ioraDev.dashboard",    "when": "view == ioraDev.devices",    "group": "navigation@3" },
        { "command": "ioraDev.refresh",                     "when": "view == ioraDev.services",   "group": "navigation@1" },
        { "command": "ioraDev.serviceLogs",                 "when": "view == ioraDev.services",   "group": "navigation@2" },
        { "command": "ioraDev.openServiceLiveLogs",         "when": "view == ioraDev.services",   "group": "navigation@3" },
        { "command": "ioraDev.deploy",       "when": "view == ioraDev.components", "group": "navigation@1" },
        { "command": "ioraDev.watch",        "when": "view == ioraDev.components", "group": "navigation@2" },
        { "command": "ioraDev.refresh",      "when": "view == ioraDev.components", "group": "navigation@3" },
        { "command": "ioraDev.refresh",      "when": "view == ioraDev.activity",   "group": "navigation@1" },
        { "command": "ioraDev.stopWatch",    "when": "view == ioraDev.activity",   "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "ioraDev.connectFromTree",    "when": "view == ioraDev.devices && viewItem == device",      "group": "inline" },
        { "command": "ioraDev.deployFromTree",     "when": "view == ioraDev.components && viewItem == component", "group": "inline@1" },
        { "command": "ioraDev.watchFromTree",      "when": "view == ioraDev.components && viewItem == component", "group": "inline@2" },
        { "command": "ioraDev.logsFromTree",       "when": "view == ioraDev.components && viewItem == component", "group": "inline@3" },
        { "command": "ioraDev.componentActions",   "when": "view == ioraDev.components && viewItem == component", "group": "navigation" },
        { "command": "ioraDev.stopWatchFromTree",  "when": "view == ioraDev.activity && viewItem == watch",       "group": "inline" },
        { "command": "ioraDev.openServiceLiveLogs","when": "view == ioraDev.services && viewItem == service",     "group": "inline@0" },
        { "command": "ioraDev.serviceLogsFromTree","when": "view == ioraDev.services && viewItem == service",     "group": "inline@1" },
        { "command": "ioraDev.serviceRestartFromTree","when": "view == ioraDev.services && viewItem == service", "group": "inline@2" },
        { "command": "ioraDev.openServiceUrl",     "when": "view == ioraDev.services && viewItem == service",    "group": "navigation@1" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "vsce package --out iora-dev.vsix",
    "publish": "vsce publish"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
